# Gradle / Android 构建产物
build/
.gradle/
local.properties
*.iml
.idea/
captures/
.cxx/
*.apk
*.aab
*.jks
*.keystore
# 例外：preview 变体专用的公开调试密钥（口令 android，安卓调试密钥的标准值）。
# 它的存在是为了让不同沙箱构建出的包签名一致，手机端能直接覆盖安装。
# 它与发布密钥 weekdayalarm-release.jks 无关，后者绝不入库。
!tools/preview-debug.keystore

# 正式签名凭据（v1.0.0）：口令与路径，绝不入库
keystore.properties

# 系统文件
.DS_Store
Thumbs.db

# JVM 崩溃转储（测试 JVM 偶发 JIT 段错误时生成，别误提交）
hs_err_pid*.log
replay_pid*.log

# 进程崩溃转储（core dump 动辄上百 MB，一旦误提交会写进历史）
core.*
core

# Python 字节码（tools/ 下的辅助脚本）
__pycache__/
*.pyc

# 设计过程稿（v1.0.0 公开前移出仓库）
# 这些是「改版前先画一张图确认」用的临时稿，对外没有意义，留着只会让 docs/ 变杂。
# screenshots/ 是正式截图，不在此列。
docs/预览-*
