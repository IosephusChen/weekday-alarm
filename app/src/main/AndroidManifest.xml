<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 悬浮窗权限：允许应用在其他应用上层显示。授予后闹钟响铃时可直接弹出全屏界面，
         不用等用户下拉通知栏。MIUI 上还需要「后台弹出界面」权限才能真正弹出。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 精确闹钟权限：USE_EXACT_ALARM 为 Android 13+ 闹钟类应用设计，安装时授予；
         SCHEDULE_EXACT_ALARM 覆盖 Android 12~13，Android 14 起默认需用户在设置中手动开启 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DaxiaoWeekAlarm">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DaxiaoWeekAlarm.Ringing"
            android:turnScreenOn="true" />

        <!-- 提前提醒弹窗（v1.23）：由全屏 intent 拉起，只显示「还有多久」+ 关闭入口，
             45 秒自动收起；不响铃、不点亮屏幕，与真正的响铃页（AlarmActivity）分开 -->
        <activity
            android:name=".PreNoticeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity="" />

        <!-- 排班日历（v1.28.1）：从主界面独立出来的核对页，点某天标请假 / 加班 -->
        <activity
            android:name=".CalendarActivity"
            android:exported="false"
            android:label="排班日历"
            android:parentActivityName=".MainActivity" />

        <!-- 设置页（v1.19.8）：设置项一级平铺；使用说明已移回主界面底部折叠卡 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="设置"
            android:parentActivityName=".MainActivity" />

        <!-- 新手引导（v1.19.9）：首次启动展示 3 页图解；设置页可随时重看。
             theme 里去掉启动时的窗口预览，避免引导页出现前先闪一下主界面。 -->
        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:label="新手引导"
            android:parentActivityName=".MainActivity" />

        <!-- 更新日志（v1.22.3）：设置页入口；升级后首次启动也会弹一次本次更新。
             纯展示页，数据内置在 Changelog 里，不需要网络。 -->
        <activity
            android:name=".ChangelogActivity"
            android:exported="false"
            android:label="更新日志"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".PreNoticeReceiver"
            android:exported="false" />

        <!-- 响铃自动停止（v1.18）：由 AlarmService 注册的定时广播触发，停掉前台服务。 -->
        <receiver
            android:name=".StopReceiver"
            android:exported="false" />

        <!-- 睡前提醒（v1.20）：每晚一条「明天要不要早起」，通知里的「明天请假」也走这里。 -->
        <receiver
            android:name=".BedtimeReceiver"
            android:exported="false" />

        <!-- 桌面小组件（v1.19）：展示下一个闹钟；更新由主 App 主动推送，故 exported=false。 -->
        <receiver
            android:name=".NextAlarmWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_alarm_widget_info" />
        </receiver>

        <!-- 桌面小组件（v1.20）：本周班表，一眼看清这周哪天上班。 -->
        <receiver
            android:name=".WeekScheduleWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_schedule_widget_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- v1.19.9：时区 / 系统时间变化后重排，否则已注册的闹钟会在错误的钟点响 -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
