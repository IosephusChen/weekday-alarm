<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 悬浮窗权限：允许应用在其他应用上层显示。授予后闹钟响铃时可直接弹出全屏界面，
         不用等用户下拉通知栏。MIUI 上还需要「后台弹出界面」权限才能真正弹出。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 精确闹钟权限：USE_EXACT_ALARM 为 Android 13+ 闹钟类应用设计，安装时授予；
         SCHEDULE_EXACT_ALARM 覆盖 Android 12~13，Android 14 起默认需用户在设置中手动开启 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeekdayAlarm">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WeekdayAlarm.Ringing"
            android:turnScreenOn="true" />

        <!-- 锁屏显示自测页（v0.55.3）：由 AlarmManager 在用户锁屏后拉起，
             停留两秒多自己关掉。不响铃、不发通知、不碰排班。
             showWhenLocked + turnScreenOn 就是被测的那两件事本身——
             它们生效，这一页才盖得住锁屏、才点得亮屏幕。 -->
        <activity
            android:name=".LockProbeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WeekdayAlarm.LockProbe"
            android:turnScreenOn="true" />

        <!-- 设置页（v0.22.1）：设置项一级平铺；使用说明已移回主界面底部折叠卡 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="设置"
            android:parentActivityName=".MainActivity" />

        <!-- 设置的二级页（v0.60.0）：主页的「更多响铃设置」「更多设置」指向这里。
             一个 Activity 承载两段，靠 intent extra 决定显示哪段。
             parent 指回设置页，系统返回手势能顺着原路退。 -->
        <activity
            android:name=".MoreSettingsActivity"
            android:exported="false"
            android:label="更多设置"
            android:parentActivityName=".SettingsActivity" />

        <!-- 使用说明（v0.50.0）：首页底部一行入口指向这里。
             别再指到 GuideActivity——那是 3 页设置向导，不是随时能查的说明书。 -->
        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:label="使用说明"
            android:parentActivityName=".MainActivity" />

        <!-- 新手引导（v0.23.0）：首次启动展示 3 页图解；设置页可随时重看。
             theme 里去掉启动时的窗口预览，避免引导页出现前先闪一下主界面。 -->
        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:label="新手引导"
            android:parentActivityName=".MainActivity" />

        <!-- 更新日志（v0.29.0）：设置页入口；升级后首次启动也会弹一次本次更新。
             纯展示页，数据内置在 Changelog 里，不需要网络。 -->
        <activity
            android:name=".ChangelogActivity"
            android:exported="false"
            android:label="更新日志"
            android:parentActivityName=".MainActivity" />

        <!-- 关于（v0.87.1）：版本、源码、许可、免责、隐私、崩溃日志导出。
             闹钟类应用必须写清「不保证一定响」，这一页是它的落点。 -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="关于"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".PreNoticeReceiver"
            android:exported="false" />

        <!-- 每日零点后的组件刷新（v0.77.2）：由 WidgetTicker 挂的精确闹钟触发，
             只做「重画三个组件」一件事。显式 Intent 指定组件，不需要 intent-filter。 -->
        <receiver
            android:name=".WidgetTickReceiver"
            android:exported="false" />

        <!-- 响铃自动停止（v1.18）：由 AlarmService 注册的定时广播触发，停掉前台服务。 -->
        <receiver
            android:name=".StopReceiver"
            android:exported="false" />

        <!-- 稍后提醒期间的「取消」按钮（v1.38）：只撤掉待触发的那一次小睡。 -->
        <receiver
            android:name=".SnoozeReceiver"
            android:exported="false" />

        <!-- 睡前提醒（v1.20）：每晚一条「明天要不要早起」，通知里的「明天请假」也走这里。 -->
        <receiver
            android:name=".BedtimeReceiver"
            android:exported="false" />

        <!-- 桌面小组件（v1.19）：展示下一个闹钟；更新由主 App 主动推送，故 exported=false。
             v0.68.0 起固定 4×2，内容 = 闹钟两行 + 本周七格（原 4×4 那份已删）。 -->
        <receiver
            android:name=".NextAlarmWidget"
            android:exported="false"
            android:label="下一个闹钟">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_alarm_widget_info" />
        </receiver>

        <!-- 桌面小组件（v0.67.0，v0.69.0 起三个变体，v0.71.0 定稿为两个）：
             本月班表，整月 42 格。
             v0.71.0 用户实际试用后定了：留 4×4 完整（带按钮）和 4×3 极简（无按钮），
             删掉 4×3 紧凑（和极简只差底部按钮，冗余）。 -->
        <receiver
            android:name=".MonthScheduleWidget"
            android:exported="false"
            android:label="本月班表 · 完整 4×4">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/month_schedule_widget_info" />
        </receiver>

        <receiver
            android:name=".MonthMinimalWidget"
            android:exported="false"
            android:label="本月班表 · 极简 4×3">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/month_minimal_widget_info" />
        </receiver>

        <!-- v0.87.1：exported 改 false。系统广播（开机 / 时区 / 改时间 / 覆盖安装）由系统发出，
             不受 exported 限制；原来设 true 等于任何 App 都能显式启动它、反复触发全量重排。 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- v0.23.0：时区 / 系统时间变化后重排，否则已注册的闹钟会在错误的钟点响 -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
