<?xml version="1.0" encoding="utf-8"?>
<!-- 「+ 添加闹钟」：虚线框。实心淡紫块看着像「已经存在的按钮」，
     虚线更像「这里还能再放一行」，和上面那些实心行不抢视觉。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1F4F46E5">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="@dimen/radius_row" />
            <stroke
                android:width="1dp"
                android:color="#BFC5F2"
                android:dashWidth="5dp"
                android:dashGap="4dp" />
        </shape>
    </item>
</ripple>
