<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗主按钮的底（v1.1.0）：淡紫胶囊。

     为什么只做「折中版」而不是自绘底部条：AlertDialog 的按钮区是系统 AlertController
     的布局，彻底换掉要做一整套自定义 ViewGroup，波及全部 15 个圆角弹窗——包括
     时间滚轮、周休制度、铃声选择那些完全无关的。只换 background 是个两行改动的
     中间态：结构还是系统的，按钮看起来已经是 App 的。

     淡紫底取 guide_option_selected（引导页「已选中」那块），主色字压上去日间
     5.6:1、夜间 4.8:1，两档都过 AA。

     ripple 色走 attr 而不是写死：#1F4F46E5 那套在深色底上几乎看不见水波纹。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/guide_option_selected" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
</ripple>
