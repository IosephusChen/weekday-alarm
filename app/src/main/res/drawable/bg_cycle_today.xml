<?xml version="1.0" encoding="utf-8"?>
<!-- 轮班格子「今天」骑沿角标的底（v1.20.2）。

     v1.20.1 用的是 bg_tag_today（day_today_bg：深色 #2A2F5C），压在近黑格底
     (#1C1F35) 上几乎同色，胶囊显不出来，看着仍是一行裸字——这正是用户说的
     「和效果图不一样」的主因之一。这里换成实心 indigo（深色 #818CF8 / 浅色 #4F46E5）
     + 反白字：一枚清清楚楚的填充胶囊，骑在格子上沿外侧。

     圆角 radius_chip，守 DesignTokenTest。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/indigo" />
    <corners android:radius="@dimen/radius_chip" />
</shape>
