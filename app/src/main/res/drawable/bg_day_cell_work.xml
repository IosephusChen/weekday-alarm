<?xml version="1.0" encoding="utf-8"?>
<!-- 引导页七格里的一个格子（v1.2.0）。

     上班 = work_cell_bg 实心，休息 = 淡灰实心。不用 state_selected 做 selector：
     这两个状态切换靠的是点击，而不是「焦点 / 选中」，用代码换背景更直白。

     v1.13.0：底从 @color/indigo 换成 @color/work_cell_bg。indigo 在夜间是
     #818CF8，白字压上去 2.96:1；这个 key 日夜各有一档，都过 4.5:1。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/work_cell_bg" />
    <corners android:radius="@dimen/radius_chip" />
</shape>
