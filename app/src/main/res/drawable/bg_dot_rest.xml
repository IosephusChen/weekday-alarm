<?xml version="1.0" encoding="utf-8"?>
<!-- 休息日的状态点（v1.1.1）：与 bg_dot_work 同尺寸，只换色。
     用 day_rest_stroke（#CBD5E1）而不是 @color/line —— 后者在白卡上几乎看不见，
     点在 8dp 这个尺寸上就彻底消失了，休息那几天会读成「没有点」。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/day_rest_stroke" />
    <size
        android:width="8dp"
        android:height="8dp" />
</shape>
