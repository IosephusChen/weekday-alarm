<?xml version="1.0" encoding="utf-8"?>
<!-- 循环编辑器里每天行首的状态点（v1.1.1）：上班实心主色、休息浅灰。

     为什么加这个点：v1.1.0 的列表里，「上班 08:00」和「休息」都是 14sp 同色文字
     靠右排，扫一眼分不出这一行是班还是休——62 行的表要靠逐行读字。
     点是靠「有没有颜色」判断的，不读字就能看出这轮的形状。
     颜色取自日历同一套语义（indigo / day_rest_stroke），两处不会打架。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/indigo" />
    <size
        android:width="8dp"
        android:height="8dp" />
</shape>
