<?xml version="1.0" encoding="utf-8"?>
<!--
  响铃横幅的卡片底（v0.55.0 改成深色半透明）。

  为什么不再用桃色：用户要的是「透明感，和其他通知栏一样」。
  真正的系统模糊（FLAG_BLUR_BEHIND + setBlurBehindRadius）需要 Android 12+
  且系统开启「跨窗口模糊」，第三方悬浮窗基本拿不到——所以退一步，
  用「深色 + 88% 不透明」做出通知栏那种「浮在内容之上」的观感：
  底下透出一点点，但不至于让字压到壁纸上读不清。

  深色卡是刻意的：横幅只在「正在响铃」时出现，那一刻要的是「被叫醒」，
  不是「融入界面」。白天夜里都用这一张，所以没有浅色版本。

  圆角 22dp、1dp 白色 20% 描边：悬浮窗吃不到 elevation 阴影，靠描边交代边界。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/float_card_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/float_card_line" />
    <corners android:radius="@dimen/radius_banner" />
</shape>
