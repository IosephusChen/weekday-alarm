<?xml version="1.0" encoding="utf-8"?>
<!-- 响铃横幅的卡片底（v1.41.0）：大圆角 + 细边。

     横幅贴顶通栏，圆角要够大才像系统闹钟那张卡（24dp），又不至于圆成胶囊。
     悬浮窗吃不到主题的 elevation 阴影，所以靠一条描边把边界交代清楚；
     底色走 @color/card，深色模式下自动变成 #1C1F35。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/card" />
    <stroke
        android:width="1dp"
        android:color="@color/line" />
    <corners android:radius="24dp" />
</shape>
