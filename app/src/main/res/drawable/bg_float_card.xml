<?xml version="1.0" encoding="utf-8"?>
<!--
  响铃横幅的卡片底（v0.55.0 深色半透明；v0.92.0 换 B 方案）。

  为什么不再用桃色：用户要的是「透明感，和其他通知栏一样」。
  真正的系统模糊（FLAG_BLUR_BEHIND + setBlurBehindRadius）需要 Android 12+
  且系统开启「跨窗口模糊」，第三方悬浮窗基本拿不到——所以只能靠底色本身做观感。

  v0.92.0 的具体变化：原来是 #E61B1D2B 一整块近黑紫。用户说不难看，但在亮壁纸上
  是一块硬边的塑料板。现在换成**压暗的品牌紫**渐变（hero 那对紫压暗到 10% 亮度），
  顶部再叠一层 12% 白向下淡出，模拟「光从上打下来」——悬浮窗吃不到 elevation 阴影，
  这是唯一能做出「浮起来」的办法，且不需要任何额外权限。

  三层：① 底色渐变 ② 顶高光 ③ 描边。描边必须压在最上层，否则会被 ② 盖掉边缘。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ① 底：angle=270 表示自上而下，startColor 在顶部 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/float_card_bg_start"
                android:endColor="@color/float_card_bg_end" />
            <corners android:radius="@dimen/radius_banner" />
        </shape>
    </item>

    <!-- ② 顶高光：白 12% 淡出到全透明 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1FFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="@dimen/radius_banner" />
        </shape>
    </item>

    <!-- ③ 白 20% 描边：交代边界，代替拿不到的阴影 -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/float_card_line" />
            <corners android:radius="@dimen/radius_banner" />
        </shape>
    </item>
</layer-list>
