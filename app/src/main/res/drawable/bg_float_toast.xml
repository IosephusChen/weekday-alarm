<?xml version="1.0" encoding="utf-8"?>
<!--
  稍后提醒生效后的短暂提示（v0.55.2）。

  为什么要它：点「稍后提醒」后横幅立刻消失，通知栏那条也要等一两秒才出现，
  中间这一段屏幕上什么都没有——用户不确定按钮到底点上了没有，
  于是会再点一次，结果多排一次小睡。

  样式跟横幅同一套（深色半透明 + 白色文字），但做成居中的小胶囊：
  它只是回执，不该再占一次视觉主位，所以不做通栏、不带按钮、2.4 秒自己消失。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/float_card_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/float_card_line" />
    <corners android:radius="@dimen/radius_banner" />
</shape>
