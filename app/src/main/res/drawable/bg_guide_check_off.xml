<?xml version="1.0" encoding="utf-8"?>
<!-- 引导页「隔周换一次」的未选中态（v1.2.0）。

     18dp 方块配 2dp 圆角（radius_hairline）——不是不想做得更圆，是 DesignTokenTest
     只允许七档圆角，而 18dp 见方的控件用 10dp（radius_chip）会圆成一个丸子。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="18dp"
        android:height="18dp" />
    <solid android:color="@color/card" />
    <stroke
        android:width="1.5dp"
        android:color="@color/line" />
    <corners android:radius="@dimen/radius_hairline" />
</shape>
