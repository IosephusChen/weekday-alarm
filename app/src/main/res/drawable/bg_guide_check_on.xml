<?xml version="1.0" encoding="utf-8"?>
<!-- 引导页「隔周换一次」的选中态（v1.2.0）：indigo 底 + 居中白勾。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="18dp"
                android:height="18dp" />
            <solid android:color="@color/indigo" />
            <corners android:radius="@dimen/radius_hairline" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_check_mini"
        android:gravity="center" />
</layer-list>
