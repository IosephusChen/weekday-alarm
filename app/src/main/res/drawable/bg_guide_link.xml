<?xml version="1.0" encoding="utf-8"?>
<!-- 引导页正文里的两处文字链接（「我是几天一轮的班」「导入配置」）的按压反馈。
     v1.8.3：原来是 ?attr/selectableItemBackgroundBorderless——宽 200dp 的链接
     按下时涟漪会画成一个直径 200dp 的大灰圆，还越出文字盖住上面的卡片，
     截图上就是白页中间凭空一个圆。改成本视图边界内的圆角矩形。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#14000000">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_chip" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</ripple>
