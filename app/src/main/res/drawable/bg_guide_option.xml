<?xml version="1.0" encoding="utf-8"?>
<!-- 引导页选项卡（v1.25.0）：未选中 = 白底细边，选中 = 淡紫底 + 主色描边。
     用 selector 而不是在代码里改背景，选中态切换只要 setSelected()。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#EEF0FE" />
            <stroke
                android:width="1.5dp"
                android:color="@color/indigo" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke
                android:width="1dp"
                android:color="@color/line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
