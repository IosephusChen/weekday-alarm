<?xml version="1.0" encoding="utf-8"?>
<!-- v1.26.7：整屏铺满版紫色渐变。

     与 bg_hero 的唯一区别是去掉 22dp 圆角。bg_hero 是给卡片用的（首页横幅、
     小组件、提前提醒弹窗），那些是「一块浮在浅底上的卡片」，圆角是必要的；
     响铃页是整屏接管，本来就没有「卡片」这层意思，留圆角只会让四角漏出底色。

     渐变角度与 bg_hero 保持一致（135°，indigo → violet），两版叠在一起也看不出接缝。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/hero_start"
        android:endColor="@color/hero_end" />
</shape>
