<?xml version="1.0" encoding="utf-8"?>
<!-- 应用内提示条的底（2026-11-10，A5）。深色半透明 + 圆角，压在页面内容上仍然读得清。
     不用纯黑：纯黑在浅色页面上像一块洞；这个值和小部件那层紫底同源。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E61E2235" />
    <corners android:radius="@dimen/radius_row" />
</shape>
