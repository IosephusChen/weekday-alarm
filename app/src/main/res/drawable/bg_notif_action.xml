<?xml version="1.0" encoding="utf-8"?>
<!--
  「关闭闹钟」药丸按钮底（v1.37.0）：品牌紫渐变 + 白字。

  原来是 12% 黑的灰药丸配黑字，和系统通知的操作按钮长得一样。改成实色紫渐变后，
  这条通知唯一的操作也带上了品牌色；白字在 indigo→violet 上对比度约 5:1，够读。

  和图标底共用同一组颜色与角度，两个色块才像一套。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/indigo"
        android:endColor="@color/violet" />
    <corners android:radius="100dp" />
</shape>
