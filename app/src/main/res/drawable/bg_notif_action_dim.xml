<?xml version="1.0" encoding="utf-8"?>
<!--
  次操作药丸的底（v0.89.8）：深靛实色 + 白字。

  为什么不再用描边：描边要么是紫的、要么是白的，而卡片底色在浅色模式下偏白、
  深色模式下偏深——紫描边在深卡上融掉，白描边在浅卡上只剩一个空药丸（v0.89.7
  就是按明暗在两个 drawable 之间选，而明暗这个信号在通知里根本来不及更新）。

  实色底没有这个两难：浅卡深卡上都是同一块深色，白字都够（浅卡 11:1）。
  试过 75% 半透明，压在米白卡上合成为中紫，白字只剩 5.9:1 且看着发灰——
  索性用不透明，和文字底同一个色值，两块深色在全天候都是同一块。

  和主按钮（品牌紫 #4F46E5 实底）靠色相区分主次：紫的更亮，是主操作。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/notif_text_bg" />

    <corners android:radius="@dimen/radius_pill" />

</shape>
