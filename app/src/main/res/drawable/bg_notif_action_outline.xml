<?xml version="1.0" encoding="utf-8"?>
<!--
  次要按钮的底（v0.53.1）：紫描边 + 透明底。

  响铃通知有两个操作：「停止」是主操作，用实色紫渐变；「N 分钟后再响」是次操作，
  用描边。两个都做成实色会抢视线，都做成灰的又回到「和系统闹钟分不清」的老问题。

  描边用 violet（#7C3AED）而不是 indigo：深色卡片上 indigo 偏暗，描边几乎看不见。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1.2dp"
        android:color="@color/violet" />
    <corners android:radius="100dp" />
</shape>
