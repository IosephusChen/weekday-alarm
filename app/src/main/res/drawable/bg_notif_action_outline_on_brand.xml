<?xml version="1.0" encoding="utf-8"?>
<!--
  次操作药丸的底，画在品牌紫卡片上（v0.89.1）。

  原来是 {@code bg_notif_action_outline}：violet 描边 + 透明底。那是给「白/深灰卡片」
  配的——描边要在卡片底上看得见。v0.89.1 起卡片底固定为品牌紫，同一个紫描边
  压上去就融进背景了，只剩一个空药丸。

  改成 60% 白描边：在 hero 渐变两端（#4F46E5 / #7C3AED）上都清楚，又不像实色药丸
  那样和主操作抢视线。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1.2dp"
        android:color="#99FFFFFF" />
    <corners android:radius="@dimen/radius_pill" />
</shape>
