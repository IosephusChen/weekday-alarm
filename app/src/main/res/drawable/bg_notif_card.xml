<?xml version="1.0" encoding="utf-8"?>
<!--
  通知卡片自带的底（v0.89.1）：品牌紫渐变 + 圆角。

  <p><b>为什么要自己画底</b>：v0.87.7 认为「卡片底色跟系统明暗走」，于是按
  {@code Resources.getSystem().uiMode} 挑白字或近黑字。2026-10-28 用户截图推翻了
  这个前提——系统是深色模式，睡前提醒的标题却是近黑（#1E2235），压在系统染出的
  紫底上几乎看不见。

  真机上的实际情况是：通知一旦 {@code setColor(indigo)}，部分 ROM 会把整张卡片
  按这个色做 colorized 染色，**底色与明暗模式无关**；而 App 进程里读到的
  {@code uiMode} 又可能被「单应用深色」之类的覆盖影响。两条都不可控，判断必然出错。

  现在改成：底色由我们自己画，文字色固定为白。系统染不染色、深浅怎么切，
  文字永远压在这块紫上，对比度恒定（标题 6.3:1，正文 5.2:1）。

  渐变两端沿用 hero_start / hero_end（v0.73.1 立的固定 token，无 values-night 版），
  与左侧图标底、右侧药丸按钮同一套紫，三个色块才像一家。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/hero_start"
        android:endColor="@color/hero_end" />
    <corners android:radius="@dimen/radius_row" />
</shape>
