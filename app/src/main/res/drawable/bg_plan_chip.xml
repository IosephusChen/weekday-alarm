<?xml version="1.0" encoding="utf-8"?>
<!-- 制度卡里的胶囊按钮（v1.16.0）：大小周的「大周 / 小周」、自定义的七个日子。

     选中 = 白底 + 1.5dp 主色描边，未选 = 白底 + 1dp 细边，两端全圆（radius_pill）。
     用 selector 而不是在代码里换背景：选中态切换只要 setSelected()，和
     {@link bg_guide_option} 同一套写法，两处不会各长一半。

     和 bg_guide_option 的差别只在圆角与底色：那张卡是 14dp 圆角、选中带淡紫底，
     适合「一段两行文字」的卡片；这里是一颗 32dp 高的按钮，圆角必须取满才像按钮。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke
                android:width="1.5dp"
                android:color="@color/indigo" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke
                android:width="1dp"
                android:color="@color/pill_rest_stroke" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
</selector>
