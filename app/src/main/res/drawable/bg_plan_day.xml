<?xml version="1.0" encoding="utf-8"?>
<!-- 「自定义」那七个小方块（v1.16.0）。

     和胶囊按钮同一个语义，但形状是圆角方块：一排七个，读的是「一周有几天」，
     不是一颗颗按钮。未选 = 实心浅灰（rest_cell_bg，和日历里的「休」格同一个色），
     选中 = 白底 + 1.5dp 主色描边——两种状态都是一块，不是一个框。

     不用 bg_guide_option：那张是 14dp 圆角、选中带淡紫底，铺在 46dp 宽的小方块上
     会变成七颗圆润的葡萄，而且七个同色淡紫块并排后分不清哪个选中。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke
                android:width="1.5dp"
                android:color="@color/indigo" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rest_cell_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/pill_rest_stroke" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
</selector>
