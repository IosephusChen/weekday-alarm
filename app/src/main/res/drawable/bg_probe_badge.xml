<?xml version="1.0" encoding="utf-8"?>
<!-- 锁屏自测页的状态圆盘：通过（v1.0.3）。
     12% 透明度的状态色打底 + 1dp 同色淡描边。比「纯色实心圆」轻，
     压在锁屏壁纸上不至于糊成一块；描边让边缘在浅色壁纸上也能立住。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <solid android:color="#2E4ADE80" />
    <stroke
        android:width="1dp"
        android:color="#4D4ADE80" />
</shape>
