<?xml version="1.0" encoding="utf-8"?>
<!-- 「N 天一轮」表里的「班」胶囊（v1.5.0 二次调）。

     v1.5.0 首发时这里借的是 bg_day_cell_work（indigo 实心 + 白字），与引导页
     的格子同款。真机上一屏六颗深紫药丸，反馈「颜色太重」。

     症结不在颜色，在位置：一张 20 天的表里 19 天都在上班，多数派拿了最重的
     颜色，扫一眼全是紫块，唯一的「休」反而被淹。格子能用实心是因为一块面积
     只讲一天；这里一列排下来是同一个词重复 N 遍，重量该跟着信息量走。

     于是退成「浅底 + 同色字」：形状、位置、对齐全不变，仍看得出是一格状态，
     但不再往下压。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/pill_work_bg" />
    <corners android:radius="@dimen/radius_chip" />
</shape>
