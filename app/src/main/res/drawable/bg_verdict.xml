<?xml version="1.0" encoding="utf-8"?>
<!-- 班表页顶部的结论条（v1.5.0）。

     班表页从上到下五张卡原来全是 bg_dialog_row（白底 + 发丝边 + 14dp 圆角），
     于是「你现在按哪张表排」和「要不要跟节假日放假」长得一模一样——最该被
     一眼看到的那句，得逐行读过才知道它是结论。

     浅靛底 + 靛字把它从「一个设置项」变回「一句结论」。圆角沿用 radius_row：
     它仍然在这串卡的队列里，变的是身份不是形状。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/verdict_bg" />
    <corners android:radius="@dimen/radius_row" />
</shape>
