<?xml version="1.0" encoding="utf-8"?>
<!-- 结论条前面的「现在」小徽章（v1.5.0）。

     只有底色不够：浅靛底说明「这张卡不一样」，但没说清「不一样在哪」。
     加这两个字，结论条就从「一句加粗的话」变成「一条当前状态」——
     用户不用猜这句话是描述现在，还是描述他刚点了什么。

     文字色用 @color/bg（日间浅灰白、夜间近黑），两次都压得住 @color/indigo：
     日间 #4F46E5 底 = 5.6:1，夜间 #818CF8 底 = 6.9:1。不用 white 是因为
     夜间 indigo 提亮成 #818CF8，白字只剩 2.9:1。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/indigo" />
    <corners android:radius="@dimen/radius_pill" />
</shape>
