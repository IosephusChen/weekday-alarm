<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件按钮的「已生效」态（v1.33）：实白底 + 紫字。
     为什么不用换背景色：RemoteViews 换背景只能走反射式 setInt(setBackgroundResource)，
     部分启动器上会让整次更新失败、组件停在旧内容。这里用两层 TextView 叠着、
     只切 visibility——和「今天」高亮层同一个思路，稳定且不依赖反射。

     v1.71.6：圆角跟着常态一起改全圆（10dp → 999dp）。实白底比常态亮得多是故意的——
     它是例外状态，跳一下提醒「你今天标了请假」是好事，不跟着降透明度。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F5F4FF" />
    <corners android:radius="999dp" />
</shape>
