<?xml version="1.0" encoding="utf-8"?>
<!-- 勾的占位（v1.0.4）：一枚 12dp 的透明方块，画不出任何东西，但 intrinsicWidth
     与 ic_check_mini 一致。权限清单里未开启的行挂它，四行的文字左边缘才落在
     同一条竖线上——只给开着的行加勾，反而会让它们错开半个勾的宽度。
     用 shape 而不是空 vector：vector 没有 path 时 inflate 会抛 NotFoundException。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="12dp"
        android:height="12dp" />
    <solid android:color="@android:color/transparent" />
</shape>
