<?xml version="1.0" encoding="utf-8"?>
<!-- App 内的小 logo。首页标题左边那枚，垫在 bg_hero 紫渐变上。

     三版走过一遍，记在这里免得再绕：
     ① 最早是「实心白圆 + 靛蓝内圆」叠出宽环，再加一笔折线针（竖针 + 斜针）。
        形状简单，24dp 下一眼读得出是钟。
     ② v1.0.5 为了跟桌面图标对上，改成细环（1.75）+ 4 个刻度 + 双针 + 轴点。
        放进 42dp 里只有 34dp 的图形区，八个元素挤在一起：环细、刻度糊、针短，
        用户 2026-11-01 反馈「不如原版简约好看」。
     ③ v1.0.6 回到 ① 的结构——宽环 + 一笔折线针，不画刻度、不画轴点。
        只改一处：内圈不再填死 #4F46E5，改成 evenOdd 挖空。原来那块紫是写死的，
        而底色是 #4F46E5 → #7C3AED 的渐变，图形落在渐变偏右的位置会透出一圈色差；
        挖空之后露出的是真底色，放哪都对。

     为什么不留刻度：这枚图标实际显示 42dp，图形区只有 34dp 左右，
     刻度线量化到像素是 1px 上下，真机上不是「表盘有刻度」而是「环上沾了灰」。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 宽环：外圆半径 8.8，内圆半径 6.1，环宽 2.7。
         evenOdd 让内外两段子路径互相挖空，环心透出底色。 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,12 m-8.8,0 a8.8,8.8 0 1,0 17.6,0 a8.8,8.8 0 1,0 -17.6,0 M12,12 m-6.1,0 a6.1,6.1 0 1,0 12.2,0 a6.1,6.1 0 1,0 -12.2,0" />

    <!-- 指针：一笔画，从 12 点方向下来到圆心，再斜向 4 点半方向 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,6.8 L12,12 L14.8,14"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />
</vector>
