<?xml version="1.0" encoding="utf-8"?>
<!--
  横幅左侧的大图标（v0.55.2 建，v1.0.10 改回时钟）。

  演变：
  - v0.55.2：从 ic_notification（圆环 + 两根指针）改成「加两个铃铛角的闹钟」。
    当时右侧「稍后提醒」也还是钟面（ic_notif_snooze），两个图标画出来一模一样，
    用户报「悬浮窗的 logo 和稍后提醒的图标一模一样」。那一版两边都动了：
    左边加铃铛角、右边换成三个 Z。
  - v1.0.10：铃铛角失去理由。右侧早就是三个 Z，撞脸风险没了；而铃铛角让这枚
    成了全项目唯一一个既不跟 logo 一致、也不属于功能图标的形状。用户 2026-11-01
    要求整体统一，几何改成与 ic_clock_white 逐字相同。

  不再另写一套比例：首页 42dp、桌面图标、这枚 24dp 共用一套几何，改形状只改一处。
  「铃铛是闹钟和时钟唯一可靠的区分点」这句话没错，但它成立的前提是右边还有一枚
  钟面——前提已经不存在了。

  44dp 的容器、10dp 内边距，图形区 24dp；环外径 17.6/24（73%），比原来那版
  （15.7，65%）略大一点，视觉上更饱满，也不会顶着内边距。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 宽环：外 8.8 / 内 6.1，evenOdd 挖空。与 ic_clock_white 逐字相同 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,12 m-8.8,0 a8.8,8.8 0 1,0 17.6,0 a8.8,8.8 0 1,0 -17.6,0 M12,12 m-6.1,0 a6.1,6.1 0 1,0 12.2,0 a6.1,6.1 0 1,0 -12.2,0" />

    <!-- 指针：一笔画，12 点下来到圆心，再斜向 4 点半。
         join 用 round 是这枚独有的：24dp 下折角若是死尖，会被抗锯齿削出缺口，
         而首页那枚显示 42dp，看不出来。 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,6.8 L12,12 L14.8,14"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.8" />
</vector>
