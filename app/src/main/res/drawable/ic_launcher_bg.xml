<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面图标底色（v1.0.8）：与 App 内 logo 的底 bg_hero 用同一对色、同一个角度。
     原来是自己一套 #6459F2 → #4C42D9（偏深偏灰），摆在 App 内的 #4F46E5 → #7C3AED
     旁边，一个闷一个亮，用户 2026-11-01 直接把两张图并排指出来。
     现在两边同色同角度（135°，左上到右下）。

     **颜色必须写死，不能引用 @color/indigo**：v0.76.1 踩过这个坑——启动器
     是系统 surface，资源解析走夜间配置，而 indigo 在 values-night 里被提亮成
     #818CF8，深夜壁纸上整个图标发白，用户反馈「像变透明了」。
     App 内界面该提亮提亮，图标这块必须日夜一个色，所以这里直接落字面值。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:endColor="#7C3AED"
        android:startColor="#4F46E5" />
</shape>
