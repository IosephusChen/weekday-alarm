        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.35" />

    <!-- 时针（10 点过一点）与分针（2 点），一长一短 -->
    <!-- 时针：短、粗、带过轴的一小段尾巴 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M55.97,55.38 L44.74,47.52"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="3.7" />
