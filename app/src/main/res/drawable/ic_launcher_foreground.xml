<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面图标前景。
     与 App 内 ic_clock_white 同一副形状：一圈白环 + 一笔折线针（12 点下来到圆心，
     再斜向 4 点半）。几何按 ic_clock_white 等比放大 2.614 倍（46/17.6），
     环宽、针长、针粗三个比例都是照抄，不再各写一套。

     走过的路记一笔：
     · v1.0.5 之前就是这个形状（描边环 + 两根粗针）。
     · v1.0.5 为了「更像钟」，换成 12 个刻度的表盘 + 10:10 双针 + 轴点。
       单看还行，但和 App 内那枚 34dp 的小 logo 摆在一起，一繁一简，像两个 App。
       用户 2026-11-01 先嫌 App 内那版碎，接着发现桌面还是另一副——于是两处一起退回。
     · v1.0.7 只退了 App 内那枚，桌面漏了；v1.0.8 补上。
     · 退回来的这版针和环一样粗（都是 7），摆在圆角方底上显得笨；用户 2026-11-01
       说「原版不好看，App 内那枚挺好看」——差别就在这里：App 内的针只有环宽的
       0.67，桌面是 1.0。现在把针收到 4.7，其余不动。

     为什么不再加刻度：48dp 时整个图形只有 20dp 出头，12 个刻度落到像素上是
     一圈毛刺，读起来不是「表盘」而是「环上沾了灰」。

     所有元素都在 66dp 安全区内：环外缘半径 23。
     monochrome 层复用同一份图形，所以这里只能是纯白，不能带渐变；
     底色渐变放在 background 层。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 表盘环：圆心 (54,54)，中线半径 19.5，描边 7（外缘 23，内缘 16） -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54 m-19.5,0 a19.5,19.5 0 1,0 39,0 a19.5,19.5 0 1,0 -39,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7" />

    <!-- 指针：一笔画，与 ic_clock_white 里那条同形 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54 L54,40.4"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="4.7" />
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54 L61.3,59.2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="4.7" />
</vector>
