<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面图标前景（v1.0.5 重画）。
     原来是一个粗线条的空表盘：白描边圆 + 两根指向 12 点和 4 点的粗针。
     在桌面 48dp 下就是一块白圈，跟系统自带的「时钟」几乎分不出来，
     也看不出这是个闹钟。

     现在换成带刻度的表盘：12 个刻度（3/6/9/12 四个略粗略长）把「钟」
     的语义立住，指针改 10:10 —— 两根针一长一短、开口向上，是钟表行业
     通行的展示时间，也是视觉上最平衡的一个角度。

     所有元素都在 66dp 安全区（半径 33）内：环外缘 26.25，刻度外端 18.9。
     monochrome 层复用同一份图形，所以这里只能是纯白，不能带渐变；
     底色渐变放在 background 层。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 表盘环：圆心 (54,54)，中线半径 23.5，线宽 5.5 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54 m-24.6,0 a24.6,24.6 0 1,0 49.2,0 a24.6,24.6 0 1,0 -49.2,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5" />

    <!-- 12 个刻度：3/6/9/12 四个（主位）更粗更长 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,34.8 L54,38.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2.4" />
    <path
        android:fillColor="#00000000"
        android:pathData="M63.6,37.37 L62.65,39.02"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.35" />
    <path
        android:fillColor="#00000000"
