<?xml version="1.0" encoding="utf-8"?>
<!--
  通知栏小图标（v0.34.1 建，v1.0.9 改形状）。

  从 v1.0.9 起与 App 内 ic_clock_white、桌面图标同一副形状：一圈宽环 + 一笔折线针
  （12 点下来到圆心，再斜向 4 点半）。三处只差比例，不再各写一套。

  比例为什么不照抄：ic_clock_white 的环宽占外径 30.7%，那是给 42dp 用的；
  这枚在状态栏和小部件头部都只有 18dp，照搬环会粗到把针挤没。所以环收到 2.6
  （25.5%）、针加粗到 2.2，外缘仍是 10.2（24 视口的 85%）——占位没变，变的是内部结构。

  旧版（v0.34.1 起）是「环 + 两根分开的针」：18dp 下两根各 1.8px，中间还夹一道缝，
  看着像表盘上落了两个白点。折线针是一笔画，转折处 round join 相接，
  小尺寸下连成一根完整的「时:分」，这是换掉它的唯一理由。

  再往前那版的问题（留档，别再走回去）：圆心在 (12, 6.5) 而不是画布中心，
  且只有一根朝下的针，渲染出来是一个偏上的小圆圈加一个点。

  单色白、透明底——通知栏小图标的硬要求，系统会按状态栏前景色重新染色，
  这里写的白只是给它一个掩膜。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 表盘：圆心 (12,12)，中线半径 8.9，描边 2.6，外缘 10.2 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,12 m-8.9,0 a8.9,8.9 0 1,0 17.8,0 a8.9,8.9 0 1,0 -17.8,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.6" />
    <!-- 指针：一笔画，12 点下来到圆心，再斜向 4 点半。
         join 用 round：18dp 下折角若是死尖，会被抗锯齿削出一个缺口。 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,6.9 L12,12 L14.6,13.75"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
</vector>
