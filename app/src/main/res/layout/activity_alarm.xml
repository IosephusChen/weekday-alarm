<?xml version="1.0" encoding="utf-8"?>
<!-- v0.40.2：参考澎湃系统自带闹钟重排版式。

     主视觉换成「现在几点」。半睡半醒时这是唯一真正要紧的信息——人要先知道
     「几点了」才能判断要不要再眯五分钟。原先的时钟图标 + 32sp 大标题在回答
     「这是什么闹钟」，可刚被叫醒的人不关心这个。

     日期退到时刻上方当副标题，闹钟名放在下面；中段留白，
     操作区（滑动停止 / 稍后提醒）沉到底部——与澎湃一致：看的一眼在最上，动的手在最下。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hero_full"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:textColor="#E6E4FF"
        android:textSize="15sp" />

    <!-- 实时时刻：整页最大的字。只到分钟，每分钟跳一次——
         定格不动会让人以为是张静态图。 -->
    <!-- v1.28：76sp 定死在大字体（系统字体 1.5×）或窄屏上会折成两行——
         「00:0」和「0」上下叠着，是全屏页最难看的一种坏法。
         这里加单行 + 自动缩放：放得下就是 76sp，放不下按比例缩到 48sp，永不折行。 -->
    <TextView
        android:id="@+id/tv_clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:autoSizeMaxTextSize="76sp"
        android:autoSizeMinTextSize="48sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="76sp" />

    <TextView
        android:id="@+id/tv_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="#CFCBFF"
        android:textSize="15sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 滑动停止：保留 v0.38.0 的滑块而不改成澎湃那种「上滑关闭」的手势提示。
         滑块要求按住才能拖，误触概率低一个量级；手势式上滑虽然更省地方，
         但整片区域都变成可触发区，半睡半醒时反而更容易误停。 -->
    <io.github.iosephuschen.weekdayalarm.SlideToStopView
        android:id="@+id/btn_stop"
        android:layout_width="match_parent"
        android:layout_height="64dp" />

    <!-- v0.40.2 原先是一个 TextView + drawableStart 加图标。实测（真机与探针一致）
         复合图标在这种条件下不参与居中定位：bounds 是 Rect(0,0-18,18)，left=0，
         图标被钉在胶囊最左边，而文字在中间，两者隔着一大段空白。
         改用 LinearLayout 显式排版，图标与文字由 gravity=center 统一居中。 -->
    <LinearLayout
        android:id="@+id/btn_snooze"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_snooze_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_snooze"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_snooze_pill" />

        <TextView
            android:id="@+id/tv_snooze_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="#CFCBFF"
        android:textSize="12sp" />
</LinearLayout>
