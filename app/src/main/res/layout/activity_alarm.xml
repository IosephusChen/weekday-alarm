<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hero"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:src="@drawable/ic_clock_white" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="该起床上班了"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="今天是上班日"
        android:textColor="#E6E4FF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="闹钟响铃中"
        android:textColor="#CFCBFF"
        android:textSize="13sp" />

    <!-- v1.26.0：从「点一下就停」改成滑动。半睡半醒时一个占满屏宽的大按钮就是陷阱：
         手一碰就关了，人还没醒。滑动要求一段有方向的位移，误触概率低一个量级。 -->
    <com.daxz.weekalarm.SlideToStopView
        android:id="@+id/btn_stop"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="44dp" />

    <TextView
        android:id="@+id/btn_snooze"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_ghost"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="5分钟后再响"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="滑到底才会停 · 铃声会一直响"
        android:textColor="#CFCBFF"
        android:textSize="12sp" />
</LinearLayout>
