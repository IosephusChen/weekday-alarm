<?xml version="1.0" encoding="utf-8"?>
<!-- 排班日历（v1.28.1）。

     原来这张卡塞在主界面里，占 460dp——主界面整屏约 1250dp，用户想改个闹钟时间
     得先滚过一整个月的格子。而日历的真实用法是「偶尔核对、临时标个请假」，
     不是每天都要看。所以独立成页，主界面只留一个入口行 + 今日状态。

     内容原样搬过来：翻月、星期表头、6×7 格子、图例、请假 / 加班总数与清除。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 标题栏：返回 + 页名 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_time_outline"
                android:clickable="true"
                android:contentDescription="返回"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="排班日历"
                android:textColor="@color/ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- 回到本月：翻了几个月之后一键归位，比连点「‹」强 -->
            <TextView
                android:id="@+id/btn_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_time_outline"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="回本月"
                android:textColor="@color/indigo"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btn_prev"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_time_outline"
                    android:clickable="true"
                    android:contentDescription="上个月"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_cal_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_next"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_time_outline"
                    android:clickable="true"
                    android:contentDescription="下个月"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cal_dow_0"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="一" />

                <TextView
                    android:id="@+id/cal_dow_1"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="二" />

                <TextView
                    android:id="@+id/cal_dow_2"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="三" />

                <TextView
                    android:id="@+id/cal_dow_3"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="四" />

                <TextView
                    android:id="@+id/cal_dow_4"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="五" />

                <TextView
                    android:id="@+id/cal_dow_5"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="六" />

                <TextView
                    android:id="@+id/cal_dow_6"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="日" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cal_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 图例：色块由 CalendarActivity.setupLegend() 动态生成（与日历格子同款底色/描边） -->
            <LinearLayout
                android:id="@+id/legend_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/line" />

            <!-- 请假 / 加班：单日标记在日历上点对应日期，这里显示总数并支持一键清除 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_vacation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_time_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="请假标记"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_overtime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_time_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="加班标记"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 用法说明：从主界面「使用说明」里摘出与日历直接相关的三条，
             省得用户翻回主界面才知道「点一天 = 标请假」。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="怎么用"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FieldHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.3"
                android:text="· 上班日 / 调休补班日：点一下 →「标记为请假」，当天全部闹钟不响，再点一次取消。\n· 休息日 / 法定节假日：点一下 →「标记为加班」，当天「仅上班日」闹钟照响。\n· 格子里的「班 / 休 / 假 / 补」是当天状态；节日名会代替「假」显示。" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
