<?xml version="1.0" encoding="utf-8"?>
<!-- 更新日志页（v0.29.0）。
     设置 → 其他 → 更新日志进入；每版一张白卡，从新到旧，当前版本用主色标出。
     卡片内容由 Changelog.renderInto 动态生成，这里只留骨架。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sv_changelog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 顶部栏：返回 + 标题（与设置页同款） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_time_outline"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="‹ 返回"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="更新日志"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- v1.1.0：一行统计拆成两行两个字号。
             原来「共 237 个版本 · 最近更新 2026/10/31」和「1.0 之前为测试期…」
             用 \n 挤在同一个 12sp TextView 里，一行是统计、一行是免责，长得一样。
             现在统计 13sp（语序也换了，最近更新在前），免责 11.5sp。 -->
        <TextView
            android:id="@+id/tv_changelog_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textColor="@color/sub"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_changelog_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_12"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/changelog_test_note"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/ll_changelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
