<?xml version="1.0" encoding="utf-8"?>
<!-- 「使用说明」页（v0.50.0 建页；v0.83.0 重排为「目录 + 五张卡」）。
     为什么要重排：原来是 16 段、约 1250 字的连续长文，没有目录，找「组件怎么加」只能一路滚；
     而且文案全写死在这份布局里——v0.82.0 把「稍后提醒」搬回主页后，这一页就漏改了一处。
     现在：顶部五枚目录直接跳到节 → 五张卡、每节 3–4 条短句 → 末尾两条可点的路径行，
     点一下直接进设置 / 引导（说明页第一次能反向跳回去）。
     文案全部在 strings.xml（help_*），这份只管搭壳——改字不再动布局。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/help_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 顶部栏：返回 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_time_outline"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/space_12"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="‹ 返回"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/help_title"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 目录：五枚胶囊，点一下滚到对应那节。窄屏可横滑 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_10"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/toc_s1"
                    style="@style/HelpToc"
                    android:text="@string/help_toc_schedule" />

                <TextView
                    android:id="@+id/toc_s2"
                    style="@style/HelpToc"
                    android:text="@string/help_toc_alarm" />

                <TextView
                    android:id="@+id/toc_s3"
                    style="@style/HelpToc"
                    android:text="@string/help_toc_leave" />

                <TextView
                    android:id="@+id/toc_s4"
                    style="@style/HelpToc"
                    android:text="@string/help_toc_widget" />

                <TextView
                    android:id="@+id/toc_s5"
                    style="@style/HelpToc"
                    android:text="@string/help_toc_settings" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ===== 1. 排班与日历 ===== -->
        <LinearLayout
            android:id="@+id/sec_s1"
            style="@style/HelpCard"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout style="@style/HelpSectionRow">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="①"
                    android:textColor="@color/indigo"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/HelpSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:text="@string/help_s1_title" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s1_b1" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s1_b2" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s1_b3" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 2. 闹钟 ===== -->
        <LinearLayout
            android:id="@+id/sec_s2"
            style="@style/HelpCard"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout style="@style/HelpSectionRow">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="②"
                    android:textColor="@color/indigo"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/HelpSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:text="@string/help_s2_title" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s2_b1" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s2_b2" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s2_b3" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s2_b4" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 3. 临时请假 / 加班 ===== -->
        <LinearLayout
            android:id="@+id/sec_s3"
            style="@style/HelpCard"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout style="@style/HelpSectionRow">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="③"
                    android:textColor="@color/indigo"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/HelpSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:text="@string/help_s3_title" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s3_b1" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s3_b2" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s3_b3" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s3_b4" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 4. 桌面小组件 ===== -->
        <LinearLayout
            android:id="@+id/sec_s4"
            style="@style/HelpCard"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout style="@style/HelpSectionRow">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="④"
                    android:textColor="@color/indigo"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/HelpSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:text="@string/help_s4_title" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s4_b1" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s4_b2" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s4_b3" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 5. 设置与备份 ===== -->
        <LinearLayout
            android:id="@+id/sec_s5"
            style="@style/HelpCard"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout style="@style/HelpSectionRow">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⑤"
                    android:textColor="@color/indigo"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/HelpSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:text="@string/help_s5_title" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s5_b1" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s5_b2" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s5_b3" />
            </LinearLayout>
        </LinearLayout>

        <!-- 可点路径（v0.83.0）：说明页第一次能反向跳到设置 / 引导。
             路径写成死文字迟早过期（v0.82.0 就过了一次），能点就不怕它过期。 -->
        <LinearLayout
            android:id="@+id/help_jump_settings"
            style="@style/HelpJump"
            android:layout_marginTop="@dimen/space_10">

            <TextView
                style="@style/HelpJumpText"
                android:text="@string/help_jump_settings" />

            <TextView
                style="@style/HelpJumpAction"
                android:text="@string/help_jump_settings_action" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/help_jump_guide"
            style="@style/HelpJump"
            android:layout_marginTop="@dimen/space_8">

            <TextView
                style="@style/HelpJumpText"
                android:text="@string/help_jump_guide" />

            <TextView
                style="@style/HelpJumpAction"
                android:text="@string/help_jump_guide_action" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_6"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/help_footer"
            android:textColor="@color/sub"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
