<?xml version="1.0" encoding="utf-8"?>
<!-- 「使用说明」页（v0.50.0 建页；v0.83.0 重排为「目录 + 五张卡」）。
     为什么要重排：原来是 16 段、约 1250 字的连续长文，没有目录，找「组件怎么加」只能一路滚；
     而且文案全写死在这份布局里——v0.82.0 把「稍后提醒」搬回主页后，这一页就漏改了一处。
     现在：顶部五枚目录直接跳到节 → 五张卡、每节 3–4 条短句 → 末尾两条可点的路径行，
     点一下直接进设置 / 引导（说明页第一次能反向跳回去）。
     文案全部在 strings.xml（help_*），这份只管搭壳——改字不再动布局。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/help_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 顶部栏：返回 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_time_outline"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/space_12"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="‹ 返回"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/help_title"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 目录：五枚胶囊，点一下滚到对应那节。
             v1.1.0：原来是 HorizontalScrollView 一行五枚。五枚总宽约 374dp，
             屏宽 393dp 减左右 28dp 只剩 365——溢出 9dp，第五枚「设置与备份」
             正好被裁在字中间。切一半看起来不是「还能滑」，是「布局溢出」，
             而且没有任何可滑的暗示，用户不会去试。
             改成 3 + 2 两行：多 25dp 高度，但这页本来就要滚，换来五个入口一次看全。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_10"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/toc_s1"
                    style="@style/HelpToc"
                    android:text="@string/help_toc_schedule" />

                <TextView
                    android:id="@+id/toc_s2"
                    style="@style/HelpToc"
                    android:text="@string/help_toc_alarm" />

                <TextView
                    android:id="@+id/toc_s3"
                    style="@style/HelpToc"
                    android:text="@string/help_toc_leave" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/toc_s4"
                    style="@style/HelpToc"
                    android:text="@string/help_toc_widget" />

                <TextView
                    android:id="@+id/toc_s5"
                    style="@style/HelpToc"
                    android:text="@string/help_toc_settings" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 1. 排班与日历 ===== -->
        <LinearLayout
            android:id="@+id/sec_s1"
            style="@style/HelpCard"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout style="@style/HelpSectionRow">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="①"
                    android:textColor="@color/indigo"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/HelpSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:text="@string/help_s1_title" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s1_b1" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s1_b2" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s1_b3" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 2. 闹钟 ===== -->
        <LinearLayout
            android:id="@+id/sec_s2"
            style="@style/HelpCard"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout style="@style/HelpSectionRow">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="②"
                    android:textColor="@color/indigo"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/HelpSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:text="@string/help_s2_title" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s2_b1" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s2_b2" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s2_b3" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s2_b4" />
            </LinearLayout>

            <!-- v1.10.1：关机。两条一对——先说做不到，再给一条能走的路。 -->
            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s2_b5" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s2_b6" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 3. 临时请假 / 加班 ===== -->
        <LinearLayout
            android:id="@+id/sec_s3"
            style="@style/HelpCard"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout style="@style/HelpSectionRow">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="③"
                    android:textColor="@color/indigo"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/HelpSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:text="@string/help_s3_title" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s3_b1" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s3_b2" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s3_b3" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s3_b4" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 4. 桌面小组件 ===== -->
        <LinearLayout
            android:id="@+id/sec_s4"
            style="@style/HelpCard"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout style="@style/HelpSectionRow">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="④"
                    android:textColor="@color/indigo"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/HelpSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:text="@string/help_s4_title" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s4_b1" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s4_b2" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s4_b3" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 5. 设置与备份 ===== -->
        <LinearLayout
            android:id="@+id/sec_s5"
            style="@style/HelpCard"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout style="@style/HelpSectionRow">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⑤"
                    android:textColor="@color/indigo"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/HelpSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:text="@string/help_s5_title" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s5_b1" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s5_b2" />
            </LinearLayout>

            <LinearLayout style="@style/HelpItemRow">
                <TextView style="@style/HelpDot" />
                <TextView
                    style="@style/HelpItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/help_s5_b3" />
            </LinearLayout>
        </LinearLayout>

        <!-- v1.1.0：删掉了原来底部两行「打开设置 / 去查看」的可点路径。
             它们的职责是「回跳」，而这页的入口本来就在设置里——用户从
             「设置 → 其他设置 → 使用说明」进来，按返回就在设置页，多一个
             「打开设置」是原地打转；引导页同理，设置里有常驻的「重看」。
             正文里也没有任何一条写死了「设置 → 某某」的路径，删掉不会留下
             指不到的死文字（v0.83.0 加它是因为当时正文里写过路径）。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_6"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/help_footer"
            android:textColor="@color/sub"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
