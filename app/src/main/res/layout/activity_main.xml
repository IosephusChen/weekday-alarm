<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面（v1.46.4）：今天 → 闹钟 → 日历，从上到下按「每天要看的先后」排。
     ① 今日状态：今天上不上班、距下次响铃、今天 / 明天不上班
     ② 闹钟区：闹钟列表 + 添加（主功能，紧接今日卡）
     ③ 日历区：排班日历 + 图例 + 请假 / 加班标记（核对与临时调整）
     ④ 设置与使用说明：整页独立（SettingsActivity），设置项全部平铺在一级 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 顶部标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_hero"
                android:padding="8dp"
                android:src="@drawable/ic_clock_white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="打工人闹钟"
                    android:textColor="@color/ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="大小周 / 双休 / 单休 · 上班日系统级响铃"
                    android:textColor="@color/sub"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 设置与使用说明入口（v1.19.7）：常驻标题栏右上角，一屏之内即可点到。
                 设置项与使用说明整体独立成页，主界面不再内嵌设置卡片。 -->
            <TextView
                android:id="@+id/btn_settings_entry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_time_outline"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="13dp"
                android:paddingEnd="11dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="设置 ›"
                android:textColor="@color/indigo"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 响铃中的停止入口（v1.47.1）。
             整屏响铃页和通知栏的「停止」按钮都可能被系统拦掉：后台拉起 Activity 受限、
             通知权限被关，加上没给悬浮窗就一条路都没有——用户只能强行停止 App。
             这一行不依赖任何权限，只有真的在响时才出现（默认 GONE，不影响平时布局）。 -->
        <LinearLayout
            android:id="@+id/row_ringing"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="闹钟正在响"
                android:textColor="@color/danger"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_stop_ringing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_time_outline"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:text="停止"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 今日状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hero"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 日期 + 农历两行（v1.20）：农历单独一行，窄屏也不会把日期挤成两行 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_today_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#E6E4FF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_today_lunar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text=""
                        android:textColor="#C9CEFD"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_week_chip"
                    style="@style/WeekChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_today_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="—"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_today_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="—"
                android:textColor="#E6E4FF"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.15" />

            <!-- 距下次响铃倒计时（v1.22.5）：
                 左边一句说明，右边等宽数字每秒跳。没有启用的闹钟时数字留空档，
                 副标题会写清原因，不会让用户盯着一个不动的时刻以为闹钟还会响。
                 v1.34：不再可点——「点看后三次」要多点一步才看到本来就能算出的信息，
                 用户原话「有点脱裤子放屁」。倒计时回归纯展示。 -->
            <LinearLayout
                android:id="@+id/box_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_hero_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tv_countdown_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="距下次响铃"
                    android:textColor="#D9D8FF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="--:--:--"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 今天 / 明天不上班（v1.28.1，v1.34 起并排两个）：
                 以前标一天假要滚到日历、找到今天、点一下、再确认——四步。
                 而「今天临时有事」恰恰是最常发生、也最急着操作的那一种。
                 v1.34 把「明天」也挪到旁边：睡前想起来明早要请假，不用等到明天再点。
                 v1.34.1 标记后换成「今天已请假」+ 实白底紫字（bg_hero_pill_on），
                 与桌面小组件同一套「已生效」视觉；底色由代码切换，这里只是未标记的默认态。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_day_off"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hero_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="今天不上班"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_day_off_tomorrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_hero_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="明天不上班"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===== ② 闹钟（v1.46.4 上移到日历之前）=====
             它是这个 App 的主功能，名字就叫闹钟。v1.46.3 为了把日历整月塞进第一屏，
             把闹钟列表压到了日历下面，用起来变成「想看闹钟得先滚过一整张日历」。
             现在顺序回到「今天 → 闹钟 → 日历」：今天要响什么，紧接今天的状态；
             日历退到后面，它是核对用的，不是每天要点的。
             同时删掉了「闹钟总开关」——每条闹钟本来就有自己的开关，系统闹钟也没有总开关。 -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="闹钟" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <!-- 闹钟列表：由 MainActivity.renderAlarmList() 动态生成（每行：时间/名称/规则/开关） -->
            <LinearLayout
                android:id="@+id/alarm_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp" />

            <TextView
                android:id="@+id/btn_add_alarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_add_alarm"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="13dp"
                android:text="+ 添加闹钟"
                android:textColor="@color/indigo"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== ③ 排班日历（v1.34.0 搬回首页，默认展开）=====
             v1.28.1 曾把它独立成页，理由是不想让它占主界面 460dp。用下来发现
             「收起来还得手动点一下」——核对班表、临时标请假本来就是顺手的事，
             多一次跳转就多一次放弃。现在整张卡回到首页，不折叠、不隐藏；
             渲染与单日标记都在 CalendarPanel 里，主界面只提供容器。 -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="排班日历" />

        <LinearLayout
            android:id="@+id/calendar_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 翻月：‹ 月份 ›，右侧「回本月」翻了几个月后一键归位 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_prev"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_time_outline"
                    android:clickable="true"
                    android:contentDescription="上个月"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_cal_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_time_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="回本月"
                    android:textColor="@color/indigo"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_next"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_time_outline"
                    android:clickable="true"
                    android:contentDescription="下个月"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 星期表头：顺序跟着「一周开始日」设置旋转，由 CalendarPanel 填字 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cal_dow_0"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="一" />

                <TextView
                    android:id="@+id/cal_dow_1"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="二" />

                <TextView
                    android:id="@+id/cal_dow_2"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="三" />

                <TextView
                    android:id="@+id/cal_dow_3"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="四" />

                <TextView
                    android:id="@+id/cal_dow_4"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="五" />

                <TextView
                    android:id="@+id/cal_dow_5"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="六" />

                <TextView
                    android:id="@+id/cal_dow_6"
                    style="@style/FieldHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="日" />
            </LinearLayout>

            <!-- 6×7 格子：CalendarPanel.renderCalendar() 动态生成 -->
            <LinearLayout
                android:id="@+id/cal_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 图例：色块由 CalendarPanel.setupLegend() 动态生成（与格子同款底色/描边） -->
            <LinearLayout
                android:id="@+id/legend_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ===== ④ 底部三块搬去设置页（v1.46.2）=====
             「使用说明」「测试响铃」「运行状态」原来占首页最后 190dp，全是低频操作：
             一个日常打开 App 的人不会碰其中任何一个。而首页合计已经 1578dp（2.25 屏），
             日历被它们挤到第二屏之后。
             现在三块都进设置页「其他」组：说明页入口本来设置页就有一个（新手引导旁边），
             测试响铃是调试用，运行状态是核对用——都该待在低频页面。
             首页只保留每天要看的东西：今天上不上班、闹钟、日历。 -->

    </LinearLayout>
</ScrollView>
