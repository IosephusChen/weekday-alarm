<?xml version="1.0" encoding="utf-8"?>
<!-- 设置的二级页（v0.60.0）。
     参考澎湃系统闹钟的分层：主页只留高频项，其余按领域收进这里。
     一个布局承载两段，由 MoreSettingsActivity 按 intent extra 显示其中一段：
       ring —— 响铃（时长 / 渐响 / 震动 / 稍后提醒 / 按键）
       all  —— 排班与显示、睡前提醒、检查与帮助、备份与恢复
     两段共用布局是有意的：结构相同，只有内容不同，没必要维护两份几乎一样的 XML。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 顶部栏：返回 + 标题（标题由代码按段设置） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_time_outline"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/more_back"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/more_page_title"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== 响铃 ===== -->
        <LinearLayout
            android:id="@+id/sec_ring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/more_section_ring" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/row_ring_duration"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="54dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp">

                                <TextView
                                    style="@style/SettingsTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/more_ring_duration_title" />

                                <TextView
                                    android:id="@+id/tv_ring_duration"
                                    style="@style/SettingsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/more_ring_duration_default" />

                                <TextView style="@style/SettingsChevron" />
                            </LinearLayout>

                            <View style="@style/SettingsDivider" />
                            <LinearLayout
                                android:id="@+id/row_fade_in"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="64dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp"
                                android:paddingTop="@dimen/space_10"
                                android:paddingBottom="@dimen/space_10">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/SettingsTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/more_fade_in_title" />

                                    <TextView
                                        style="@style/SettingsSummary"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_2"
                                        android:text="@string/more_fade_in_summary" />
                                </LinearLayout>

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/switch_fade_in"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="false"
                                    android:focusable="false" />
                            </LinearLayout>

                            <View style="@style/SettingsDivider" />
                            <LinearLayout
                                android:id="@+id/row_vibrate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="64dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp"
                                android:paddingTop="@dimen/space_10"
                                android:paddingBottom="@dimen/space_10">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/SettingsTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/more_vibrate_title" />

                                    <TextView
                                        style="@style/SettingsSummary"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_2"
                                        android:text="@string/more_vibrate_summary" />
                                </LinearLayout>

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/switch_vibrate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="false"
                                    android:focusable="false" />
                            </LinearLayout>

                            <View style="@style/SettingsDivider" />
                            <LinearLayout
                                android:id="@+id/row_keys"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="64dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp"
                                android:paddingTop="@dimen/space_10"
                                android:paddingBottom="@dimen/space_10">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/SettingsTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/more_keys_title" />

                                    <TextView
                                        android:id="@+id/tv_keys"
                                        style="@style/SettingsSummary"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_2"
                                        android:text="@string/more_keys_default" />
                                </LinearLayout>

                                <TextView style="@style/SettingsChevron" />
                            </LinearLayout>

                            <View style="@style/SettingsDivider" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 更多（排班 / 检查 / 备份）===== -->
        <LinearLayout
            android:id="@+id/sec_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/more_section_all" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/row_week_start"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="54dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp">

                                <TextView
                                    style="@style/SettingsTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/more_week_start_title" />

                                <TextView
                                    android:id="@+id/tv_week_start"
                                    style="@style/SettingsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/more_week_start_default" />

                                <TextView style="@style/SettingsChevron" />
                            </LinearLayout>

                            <View style="@style/SettingsDivider" />
                            <LinearLayout
                                android:id="@+id/row_horizon"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="54dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp">

                                <TextView
                                    style="@style/SettingsTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/more_horizon_title" />

                                <TextView
                                    android:id="@+id/tv_horizon"
                                    style="@style/SettingsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/more_horizon_default" />

                                <TextView style="@style/SettingsChevron" />
                            </LinearLayout>

                            <View style="@style/SettingsDivider" />

                            <!-- v0.73.7：农历节日 / 二十四节气 / 基督教节日三个开关合并成一行多选。
                                 它们都是「日历里显不显示某类名字」，同一个决策拆成三个开关，
                                 设置页平白多两行。Prefs 三个键不动（备份格式不变），只换入口。 -->
                            <LinearLayout
                                android:id="@+id/row_calendar_content"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="54dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp">

                                <TextView
                                    style="@style/SettingsTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/more_calendar_content_title" />

                                <TextView
                                    android:id="@+id/tv_calendar_content"
                                    style="@style/SettingsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_8"
                                    android:gravity="end"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:text="@string/more_calendar_content_default" />

                                <TextView style="@style/SettingsChevron" />
                            </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/more_section_check" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:clipToOutline="true"
                android:orientation="vertical">


                            <View style="@style/SettingsDivider" />
                            <LinearLayout
                                android:id="@+id/row_run_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="54dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp"
                                android:paddingTop="@dimen/space_10"
                                android:paddingBottom="@dimen/space_10">

                                <TextView
                                    style="@style/SettingsTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/more_run_status_title" />

                                <TextView
                                    android:id="@+id/tv_run_status_summary"
                                    style="@style/SettingsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/more_run_status_default" />

                                <TextView style="@style/SettingsChevron" />
                            </LinearLayout>

                            <View style="@style/SettingsDivider" />
                            <LinearLayout
                                android:id="@+id/row_onboard"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="54dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp"
                                android:paddingTop="@dimen/space_10"
                                android:paddingBottom="@dimen/space_10">

                                <TextView
                                    style="@style/SettingsTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/more_onboard_title" />

                                <TextView
                                    style="@style/SettingsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/more_onboard_action" />

                                <TextView style="@style/SettingsChevron" />
                            </LinearLayout>

                            <View style="@style/SettingsDivider" />
                            <LinearLayout
                                android:id="@+id/row_help"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="54dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp"
                                android:paddingTop="@dimen/space_10"
                                android:paddingBottom="@dimen/space_10">

                                <TextView
                                    style="@style/SettingsTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/more_help_title" />

                                <TextView
                                    style="@style/SettingsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/more_help_action" />

                                <TextView style="@style/SettingsChevron" />
                            </LinearLayout>

                            <View style="@style/SettingsDivider" />
                            <LinearLayout
                                android:id="@+id/row_changelog"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="54dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp"
                                android:paddingTop="@dimen/space_10"
                                android:paddingBottom="@dimen/space_10">

                                <TextView
                                    style="@style/SettingsTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/more_changelog_title" />

                                <!-- v0.85.5：右侧不再重复版本号。主页最底下那行「版本 x.y.z (code)」
                                     已经写全了，这里再写一遍「v0.85.4」只是同一串数字换个地方——
                                     而它属于「动作入口」（点进去看日志），不是「当前取值」。 -->
                                <TextView
                                    style="@style/SettingsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/more_help_action" />

                                <TextView style="@style/SettingsChevron" />
                            </LinearLayout>

                            <!-- 关于（v0.87.1）：版本、源码、许可、免责、隐私、崩溃日志都在这。
                                 1.0 前补——原来只有主页底部一行版本号，别人想报问题都不知道去哪。 -->
                            <View style="@style/SettingsDivider" />
                            <LinearLayout
                                android:id="@+id/row_about"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="54dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp"
                                android:paddingTop="@dimen/space_10"
                                android:paddingBottom="@dimen/space_10">

                                <TextView
                                    style="@style/SettingsTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/more_about_title" />

                                <TextView
                                    style="@style/SettingsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/more_help_action" />

                                <TextView style="@style/SettingsChevron" />
                            </LinearLayout>
            </LinearLayout>

            <!-- 数据与桌面（v0.82.0 由「桌面小组件」+「备份与恢复」合并）：
                 三件事的共同点是「把东西搬进搬出」——搬到桌面、导出成文件、从文件导入。
                 原来分成两组各一张卡，两组都只有一两条，翻起来像两份清单。
                 添加桌面（v0.63.0）：澎湃把第三方小部件收在「安卓小部件」二级列表，
                 要翻三层才找得到；这一行尽量一键加，小米桌面实测不支持，会给手动路径。
                 v0.73.4：「本月班表显示闹钟」开关已删（恒定显示）。 -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/more_section_widget" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_pin_widget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_16"
                    android:paddingTop="@dimen/space_10"
                    android:paddingEnd="14dp"
                    android:paddingBottom="@dimen/space_10">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/more_pin_widget_title" />

                        <TextView
                            style="@style/SettingsSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/more_pin_widget_summary" />
                    </LinearLayout>

                    <TextView style="@style/SettingsChevron" />
                </LinearLayout>
                <View style="@style/SettingsDivider" />

                            <LinearLayout
                                android:id="@+id/row_export"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="64dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp"
                                android:paddingTop="@dimen/space_10"
                                android:paddingBottom="@dimen/space_10">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/SettingsTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/more_export_title" />

                                    <TextView
                                        style="@style/SettingsSummary"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_2"
                                        android:text="@string/more_export_summary" />
                                </LinearLayout>

                                <TextView style="@style/SettingsChevron" />
                            </LinearLayout>

                            <View style="@style/SettingsDivider" />
                            <LinearLayout
                                android:id="@+id/row_import"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="64dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="14dp"
                                android:paddingTop="@dimen/space_10"
                                android:paddingBottom="@dimen/space_10">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/SettingsTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/more_import_title" />

                                    <TextView
                                        style="@style/SettingsSummary"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_2"
                                        android:text="@string/more_import_summary" />
                                </LinearLayout>

                                <TextView style="@style/SettingsChevron" />
                            </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
