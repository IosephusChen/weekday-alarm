<?xml version="1.0" encoding="utf-8"?>
<!-- 「设置」主页（v1.49.0 重排）。
     参考澎湃系统闹钟的分层：主页只放高频项，其余按领域进二级页。
     主页 8 项：
       闹钟    —— 音量（就地滑块）、铃声、更多响铃设置 ›
       排班    —— 周休制度、节假日数据
       提醒    —— 睡前提醒、响铃前提醒（行尾开关）
       其他    —— 更多设置 ›
     版式沿用原有语言（居中顶栏、行间 1dp 分隔线、左标题右值），
     大标题 / 去分割线等视觉改动留给 A11，不和结构改动混在一起。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 顶部栏：返回 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_time_outline"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="‹ 返回"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="设置"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== 闹钟 ===== -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="闹钟" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <!-- 音量：v1.49.0 从「点开对话框再拖」改成就地拖。
                 松手才写 Prefs——拖动过程中反复落盘会触发重排。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="闹钟音量" />

                    <TextView
                        android:id="@+id/tv_volume"
                        style="@style/SettingsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="80%" />
                </LinearLayout>

                <!-- v1.49.6：padding 不能再是 0——滑块滚到 0 时左半会被自身边界裁掉，
                     截图上就是一个「半月形」。9dp = 滑块半径，正好够整个圆画出来。 -->
                <SeekBar
                    android:id="@+id/seek_volume_embed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:minHeight="36dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:progressDrawable="@drawable/seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

                        <LinearLayout
                            android:id="@+id/row_ringtone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="54dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="14dp">

                            <TextView
                                style="@style/SettingsTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="铃声" />

                            <TextView
                                android:id="@+id/tv_ringtone"
                                style="@style/SettingsValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"
                                android:gravity="end"
                                android:text="系统默认" />

                            <TextView style="@style/SettingsChevron" />
                        </LinearLayout>

                        <View style="@style/SettingsDivider" />

            <!-- 更多响铃设置（v1.49.0）：时长、渐响、震动、稍后提醒、按键 -->
            <LinearLayout
                android:id="@+id/row_more_ring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="更多响铃设置" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 排班与节假日 ===== -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:text="排班与节假日" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/row_week_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="54dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="14dp">

                            <TextView
                                style="@style/SettingsTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="周休制度" />

                            <TextView
                                android:id="@+id/tv_week_mode"
                                style="@style/SettingsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="大小周" />

                            <TextView style="@style/SettingsChevron" />
                        </LinearLayout>

                        <View style="@style/SettingsDivider" />

                        <LinearLayout
                            android:id="@+id/row_holiday_data"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/SettingsTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="节假日数据" />

                                <TextView
                                    android:id="@+id/tv_holiday_data"
                                    style="@style/SettingsSummary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="—" />
                            </LinearLayout>

                            <TextView style="@style/SettingsChevron" />
                        </LinearLayout>

                        <View style="@style/SettingsDivider" />
        </LinearLayout>

        <!-- ===== 提醒 ===== -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:text="提醒" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <!-- 睡前提醒（v1.49.0）：整行点开关，点下面的时间改时刻——
                 与「响铃前提醒」同一套操作，不给用户两套规则。 -->
            <LinearLayout
                android:id="@+id/row_bedtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="睡前提醒" />

                    <TextView
                        android:id="@+id/tv_bedtime"
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="关闭" />
                </LinearLayout>

                <!-- 这个开关自己消费点击（与「响铃前提醒」不同）：
                     点整行是改时刻，点开关才是开/关。 -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_bedtime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

                        <LinearLayout
                            android:id="@+id/row_pre_notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/SettingsTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="响铃前提醒" />

                                <TextView
                                    android:id="@+id/tv_pre_notice"
                                    style="@style/SettingsSummary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="响铃前先在通知栏提醒一次" />
                            </LinearLayout>

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_pre_notice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:focusable="false" />
                        </LinearLayout>

                        <View style="@style/SettingsDivider" />
        </LinearLayout>

        <!-- ===== 其他 ===== -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:text="其他" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <!-- 更多设置（v1.49.0）：排班与显示、响铃、睡前提醒条件、检查与帮助、桌面小组件、备份与恢复。
                 项数随版本增减，别在注释里写死——写死的数字过期也没人记得改，
                 以页面实际为准。 -->
            <LinearLayout
                android:id="@+id/row_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="更多设置" />

                <TextView
                    style="@style/SettingsSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="排班 · 小组件 · 检查 · 备份" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/sub"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
