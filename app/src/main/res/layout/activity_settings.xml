<?xml version="1.0" encoding="utf-8"?>
<!-- 「设置」主页（v0.60.0 分层，v0.82.0 分组重排 = T6）。
     主页 9 项。四组里「闹钟 → 响铃」「其他 → 更多」改了口径（v0.82.0），
     「排班与节假日」「提醒」两处试过口语化的说法（上班日怎么算 / 什么时候提醒），
     用户 2026-10-26 判定太口语化，已改回（v0.82.1）。
       响铃        —— 音量（就地滑块）、铃声、更多响铃设置 ›
       排班与节假日 —— 周休制度、节假日数据
       提醒        —— 睡前提醒、响铃前提醒、稍后提醒（三个提醒按发生顺序排）
       更多        —— 更多设置 ›
     v0.82.0 把「稍后提醒」从二级页响铃组搬到这里：它和「响铃前提醒」是同一件事的
     两头（响之前怎么办 / 响了没起怎么办），原来隔着一个页面。
     版式沿用原有语言（居中顶栏、行间 1dp 分隔线、左标题右值），
     大标题 / 去分割线等视觉改动留给 A11，不和结构改动混在一起。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 顶部栏：返回 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_time_outline"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/settings_back"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/settings_page_title"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== 响铃 ===== -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/settings_section_alarm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <!-- 音量：v0.60.0 从「点开对话框再拖」改成就地拖。
                 松手才写 Prefs——拖动过程中反复落盘会触发重排。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_12"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_volume_label" />

                    <TextView
                        android:id="@+id/tv_volume"
                        style="@style/SettingsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_volume_default" />
                </LinearLayout>

                <!-- v0.61.4：padding 不能再是 0——滑块滚到 0 时左半会被自身边界裁掉，
                     截图上就是一个「半月形」。9dp = 滑块半径，正好够整个圆画出来。 -->
                <SeekBar
                    android:id="@+id/seek_volume_embed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:max="90"
                    android:minHeight="36dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:progressDrawable="@drawable/seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb" />

                <!-- v0.90.2：两端刻度，与音量对话框同一把尺子。

                     没有这行时，滑块停在最左，整条轨道是灰的、左边没有任何紫色填充，
                     右上角的「10%」孤零零一个数字——读起来像"当前音量 10%"，不像
                     "最低只能到 10%"。补上两端刻度之后，左下角的 10% 正好压在滑块
                     下方，右端 100% 说明这条轨道通向哪里，量程边界不用再靠拖一下试。

                     两个文字与 dialog_volume.xml 完全一致，VolumeBarTest 同时盯着两处：
                     只改对话框、漏掉设置页，就是从另一个入口进来的用户又看不明白。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="10%"
                        android:textColor="@color/sub"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="@color/sub"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/SettingsDivider" />

                        <LinearLayout
                            android:id="@+id/row_ringtone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="54dp"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/space_16"
                            android:paddingEnd="14dp">

                            <TextView
                                style="@style/SettingsTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_ringtone_title" />

                            <TextView
                                android:id="@+id/tv_ringtone"
                                style="@style/SettingsValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"
                                android:gravity="end"
                                android:text="@string/settings_ringtone_default" />

                            <TextView style="@style/SettingsChevron" />
                        </LinearLayout>

                        <View style="@style/SettingsDivider" />

            <!-- 更多响铃设置（v0.60.0）：时长、渐响、震动、稍后提醒、按键 -->
            <LinearLayout
                android:id="@+id/row_more_ring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="14dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_more_ring_title" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 排班与节假日 ===== -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/settings_section_schedule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/row_week_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="54dp"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/space_16"
                            android:paddingEnd="14dp">

                            <TextView
                                style="@style/SettingsTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_week_mode_title" />

                            <TextView
                                android:id="@+id/tv_week_mode"
                                style="@style/SettingsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_week_mode_default" />

                            <TextView style="@style/SettingsChevron" />
                        </LinearLayout>

                        <View style="@style/SettingsDivider" />

                        <LinearLayout
                            android:id="@+id/row_holiday_data"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/space_16"
                            android:paddingEnd="14dp"
                            android:paddingTop="@dimen/space_10"
                            android:paddingBottom="@dimen/space_10">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/SettingsTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_holiday_data_title" />

                                <TextView
                                    android:id="@+id/tv_holiday_data"
                                    style="@style/SettingsSummary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:text="@string/settings_holiday_data_default" />
                            </LinearLayout>

                            <TextView style="@style/SettingsChevron" />
                        </LinearLayout>

                        <View style="@style/SettingsDivider" />
        </LinearLayout>

        <!-- ===== 提醒 ===== -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/settings_section_remind" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <!-- 睡前提醒（v0.79.0）：从「开关行」改成「导航行」。
                 v0.78.0 真机反馈：右侧画着开关，用户就以为这一行只能开或关，
                 根本不知道点进去还能改时刻——它长得像「振动」「渐响」那种纯开关行，
                 行为却是「周休制度」那种导航行。现在右侧给「当前时刻 + ›」，
                 与「周休制度」「节假日数据」同一套语言：有配置的项，值在右、箭头收尾。
                 「关掉」不再是开关，而是对话框里和各个时刻并列的第一张卡。 -->
            <LinearLayout
                android:id="@+id/row_bedtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_10"
                android:paddingEnd="14dp"
                android:paddingBottom="@dimen/space_10">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_bedtime_title" />

                    <!-- 副标题只说「条件」，不说时刻——时刻已经搬到右边当值了 -->
                    <TextView
                        android:id="@+id/tv_bedtime"
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/settings_bedtime_hint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_bedtime_value"
                    style="@style/SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_bedtime_default" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

                        <LinearLayout
                            android:id="@+id/row_pre_notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/space_16"
                            android:paddingEnd="14dp"
                            android:paddingTop="@dimen/space_10"
                            android:paddingBottom="@dimen/space_10">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/SettingsTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_pre_notice_title" />

                                <TextView
                                    android:id="@+id/tv_pre_notice"
                                    style="@style/SettingsSummary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:text="@string/settings_pre_notice_summary" />
                            </LinearLayout>

                            <!-- v0.79.0：与睡前提醒同一套——开关去掉，右侧给值 + 箭头。
                                 原来「提前量」藏在副标题那一小块可点区域里（约 60dp 宽），
                                 几乎没人发现点它能改；整行点击反而是开关，两件事拧着。 -->
                            <TextView
                                android:id="@+id/tv_pre_notice_value"
                                style="@style/SettingsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView style="@style/SettingsChevron" />
                        </LinearLayout>

                        <View style="@style/SettingsDivider" />

                        <!-- 稍后提醒（v0.82.0 从二级页搬回）：与「响铃前提醒」同一组的
                             两个动作——响之前提个醒、响过之后没起再叫一次。 -->
                        <LinearLayout
                            android:id="@+id/row_snooze"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="54dp"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/space_16"
                            android:paddingEnd="14dp">

                            <TextView
                                style="@style/SettingsTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_snooze_title" />

                            <TextView
                                android:id="@+id/tv_snooze"
                                style="@style/SettingsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/more_snooze_default" />

                            <TextView style="@style/SettingsChevron" />
                        </LinearLayout>
        </LinearLayout>

        <!-- ===== 更多 ===== -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/settings_section_other" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <!-- 更多设置（v0.60.0）：排班与显示、响铃、睡前提醒条件、检查与帮助、桌面小组件、备份与恢复。
                 项数随版本增减，别在注释里写死——写死的数字过期也没人记得改，
                 以页面实际为准。 -->
            <LinearLayout
                android:id="@+id/row_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="14dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_more_title" />

                <TextView
                    style="@style/SettingsSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_more_summary" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:textColor="@color/sub"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
