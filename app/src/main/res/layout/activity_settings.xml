<?xml version="1.0" encoding="utf-8"?>
<!-- 「设置」页（v1.19.8）。
     主界面只留「闹钟」「排班日历」两张卡片，设置整体搬到这一页：
     ① 设置卡片：全部设置项一级平铺（无二级菜单）
     ② 使用说明已移回主界面底部（折叠卡片），不再埋在本页最下方
     版式统一：每行「左标题 + 右值/开关」，行高一致、左边缘对齐、行间 1dp 分隔线。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 顶部栏：返回 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_time_outline"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="‹ 返回"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="设置"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== 设置卡片：一级平铺，每行左标题 + 右值 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <TextView
                style="@style/SettingsSection"
                android:text="排程与节假日" />

            <!-- ===== 周休制度（v1.46.3 从首页搬来）=====
                 首页那张「排班」卡三行全是配置：周休制度、本周大/小周、小周休哪天，
                 一年动不了几次，却占 209dp（含分组标题），把日历挤出了第一屏。
                 显示职能不需要它——今日卡右上角的徽标已经写着「大周 · 休2天」；
                 首次设置也不需要它——新手引导第 1 页就是选周休制度。
                 所以只剩「换工作改班制」和「推算错了要校准」两个低频场景，归到设置页。 -->
            <LinearLayout
                android:id="@+id/row_week_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="周休制度" />

                <TextView
                    android:id="@+id/tv_week_mode"
                    style="@style/SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="大小周" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 大小周专属：双休 / 单休下整块隐藏 -->
            <LinearLayout
                android:id="@+id/ll_big_small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_week_big"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="本周是" />

                    <TextView
                        android:id="@+id/tv_week_big"
                        style="@style/SettingsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="大周（休2天）" />

                    <TextView style="@style/SettingsChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/row_small_rest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="小周休哪天" />

                    <TextView
                        android:id="@+id/tv_small_rest"
                        style="@style/SettingsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="周日（周六上班）" />

                    <TextView style="@style/SettingsChevron" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 一周开始日（v1.22.2）：只影响日历与「本周班表」的排列，不动排班 -->
            <LinearLayout
                android:id="@+id/row_week_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="一周开始日" />

                <TextView
                    android:id="@+id/tv_week_start"
                    style="@style/SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="周一" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 提醒范围 -->
            <LinearLayout
                android:id="@+id/row_horizon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="提醒范围" />

                <TextView
                    android:id="@+id/tv_horizon"
                    style="@style/SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未来 90 天" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 节假日数据：标题 + 数据版本摘要 -->
            <LinearLayout
                android:id="@+id/row_holiday_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="节假日数据" />

                    <TextView
                        android:id="@+id/tv_holiday_data"
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—" />
                </LinearLayout>

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 农历节日（v1.20）：日历格子用节日名替换「班/休/假」标签 -->
            <LinearLayout
                android:id="@+id/row_lunar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="农历节日" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="日历里显示春节、中秋等，日期后不再只有「班 / 休」" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_lunar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 基督教节日（v1.21）：与农历节日并列，默认关，不打扰不关心的人 -->
            <LinearLayout
                android:id="@+id/row_christian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="基督教节日" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="显示圣诞、复活节等，含天主教共同遵守的节日" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_christian"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <TextView
                style="@style/SettingsSection"
                android:text="响铃" />

            <!-- 闹钟音量 -->
            <LinearLayout
                android:id="@+id/row_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="闹钟音量" />

                <TextView
                    android:id="@+id/tv_volume"
                    style="@style/SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80%" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 铃声 -->
            <LinearLayout
                android:id="@+id/row_ringtone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="铃声" />

                <TextView
                    android:id="@+id/tv_ringtone"
                    style="@style/SettingsValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:gravity="end"
                    android:text="系统默认" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 响铃时长 -->
            <LinearLayout
                android:id="@+id/row_ring_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="响铃时长" />

                <TextView
                    android:id="@+id/tv_ring_duration"
                    style="@style/SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="不限" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 铃声渐响 -->
            <LinearLayout
                android:id="@+id/row_fade_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="铃声渐响" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="从静音逐渐变大，约 30 秒到设定音量" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_fade_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 响铃时震动 -->
            <LinearLayout
                android:id="@+id/row_vibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="响铃时震动" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="配合音量调到 0 可实现「静音仅震动」" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_vibrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <TextView
                style="@style/SettingsSection"
                android:text="提醒" />

            <!-- 稍后提醒 -->
            <LinearLayout
                android:id="@+id/row_snooze"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="稍后提醒" />

                <TextView
                    android:id="@+id/tv_snooze"
                    style="@style/SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 分钟 × 1 次" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 响铃前提醒（v1.27 改成「标题 + 副标题 + 开关」；v1.45.0 改名）
                 原名「提前提醒」——「提前」没说是提前到哪儿，和「稍后提醒」放在一起
                 还容易看混（一个提前一个稍后，都像在说推迟）。改成「响铃前提醒」，
                 和「稍后提醒」正好一前一后，不用猜。
                 参照系统设置里通知类开关的写法：一句话说清是什么，一行说清状态，
                 开关直接给开关。原先只有一行标题加一个「关闭」的值，
                 想开要先点进去才知道里面有什么。 -->
            <LinearLayout
                android:id="@+id/row_pre_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="响铃前提醒" />

                    <TextView
                        android:id="@+id/tv_pre_notice"
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="响铃前先发一条通知" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_pre_notice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 睡前提醒（v1.20）：晚上告诉你明天要不要早起、几点响 -->
            <LinearLayout
                android:id="@+id/row_bedtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="睡前提醒" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="明天要上班才提醒，可一键标记请假" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_bedtime"
                    style="@style/SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:maxLines="1"
                    android:text="关闭" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 睡前提醒的细分开关：明天休息时不打扰 -->
            <LinearLayout
                android:id="@+id/row_bedtime_workday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="仅在明天上班时提醒" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="明天休息或已请假就不发通知，免得打扰" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_bedtime_workday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <TextView
                style="@style/SettingsSection"
                android:text="其他" />

            <!-- 按键设置：标题 + 两个键的作用 -->
            <LinearLayout
                android:id="@+id/row_keys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="按键设置" />

                    <TextView
                        android:id="@+id/tv_keys"
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="音量键 · 无\n电源键 · 无" />
                </LinearLayout>

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 新手引导（v1.19.9）：首次安装会自动展示，这里提供随时重看的入口。
                 v1.41.0：说明页底部那个「第一次用？」的入口撤了，引导只剩这一处；
                 标题补上「与权限」，因为第三页就是权限清单，重看的理由往往就是查权限。 -->
            <LinearLayout
                android:id="@+id/row_onboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="新手引导与权限" />

                <TextView
                    style="@style/SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="重看" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 使用说明（v1.46.2 从首页搬来）：和新手引导相邻，两者都是「怎么用」的入口。
                 区别仍要写清楚——引导是首次的流程，说明是随时能查的参考。 -->
            <LinearLayout
                android:id="@+id/row_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="使用说明" />

                <TextView
                    style="@style/SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="查看" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 测试响铃（v1.46.2 从首页搬来）：一年点不了几次，却占了首页 64dp -->
            <LinearLayout
                android:id="@+id/row_test_ring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="测试响铃" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="立刻响一次，确认音量与铃声" />
                </LinearLayout>

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 运行状态（v1.46.2 从首页折叠卡改成对话框）：
                 核对用信息，默认不该占首页。右侧摘要仍然一眼能看出「开着没、几个提醒」。 -->
            <LinearLayout
                android:id="@+id/row_run_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="运行状态" />

                <TextView
                    android:id="@+id/tv_run_status_summary"
                    style="@style/SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- 更新日志（v1.22.3）：每版改了什么都能翻；升级后首次启动也会自动弹一次 -->
            <LinearLayout
                android:id="@+id/row_changelog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="更新日志" />

                <TextView
                    android:id="@+id/tv_changelog_version"
                    style="@style/SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.22.3" />

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 备份与恢复（v1.20）=====
             换手机 / 重装后不用重新攒设置：导出成一份 JSON，导入时整份覆盖。 -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="备份与恢复" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_export"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="导出配置" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="把闹钟、排班、请假/加班标记、音量铃声存成一个文件" />
                </LinearLayout>

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/row_import"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="导入配置" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="选择之前导出的文件恢复设置（会覆盖当前配置）" />
                </LinearLayout>

                <TextView style="@style/SettingsChevron" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="以上设置改动即时保存，返回主界面自动刷新。"
            android:textColor="@color/sub"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/sub"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
