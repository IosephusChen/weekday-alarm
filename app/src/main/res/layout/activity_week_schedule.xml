<?xml version="1.0" encoding="utf-8"?>
<!-- 「我的班表」（v1.3.0）。

     取代原来的「周休制度」五选一弹窗：那道题是自评题——想改「下周三上班」，
     得先判断自己属于哪种制度。而引导页早在 v1.2.0 就改成点格子了，两处方向相反。

     版式照 activity_about.xml：顶栏「‹ 返回 + 右对齐标题」、白卡、14dp 边距。
     进来第一眼是结论条 + 你自己那张表。

     v1.10.0：原来是「点一格立刻落盘」，重看一遍就可能把配好的表点乱。
     现在点击只改草稿，底部「保存」才写盘并重排；有未保存的改动时返回会拦一下。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- v1.10.0：点格子不再即时生效，改完点下面的「保存」。
         底部这条是固定的，不随内容滚走——滚到日历区时也能看见它还亮着。 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_time_outline"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="‹ 返回"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="我的班表"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 结论条：不用点任何东西，一眼确认现在按哪张表排。

             v1.5.0：白卡 → 浅靛底 + 「现在」徽章 + 靛字。此前这一页从上到下的
             五张卡（结论 / 两周不一样 / 法定节假日 / N 天一轮 / 旋转摘要）全是
             bg_dialog_row，同一个长相、同一个间距，于是「你现在按哪张表排」
             和「要不要跟节假日」读起来是同一级——最该被一眼看到的那句，
             得逐行读过才知道它是结论。 -->
        <LinearLayout
            android:id="@+id/card_verdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_verdict"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="13dp"
            android:paddingEnd="16dp"
            android:paddingBottom="13dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_verdict_tag"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="现在"
                android:textColor="@color/bg"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_verdict"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:text="双休"
                android:textColor="@color/indigo"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <io.github.iosephuschen.weekdayalarm.WeekGrid
            android:id="@+id/week_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12" />

        <!-- v1.8.0：班次。轮班的人先定义「白班 08:00–20:00」「夜班 20:00–次日 08:00」，
             再回到下面那张表把每天指派给某个班次。两行分开，是因为它们是两种动作：
             定义班次不常改，排循环每月都要动一次。 -->
        <LinearLayout
            android:id="@+id/row_shifts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_dialog_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="13dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="班次"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_shifts_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="白班 08:00 – 20:00 · 夜班 20:00 – 次日 08:00"
                    android:textColor="@color/sub"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView style="@style/SettingsChevron" />
        </LinearLayout>

        <!-- 按 N 天一轮：七格表达不了 62 天的表，换成一张摘要卡 -->
        <LinearLayout
            android:id="@+id/card_rotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_dialog_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="13dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_rotation_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 天一轮 · 上2休2"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_rotation_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="首日班次确定后，按此顺序循环"
                    android:textColor="@color/sub"
                    android:textSize="11sp" />

                <!-- v1.7.0：填过的时刻在这里回显。以前班表页只写「14 天一轮 · 上12休2」，
                     用户填完时刻回到首页，中间那一步完全不可见，会以为填了等于没填 -->
                <TextView
                    android:id="@+id/tv_rotation_times"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/body"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView style="@style/SettingsChevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_biweekly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_dialog_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="两周不一样"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <!-- v1.5.0：「会多出一行」删掉。那是实现的说法——用户要的是
                     「两周能填不一样」，不是「一个界面里多一行」。 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="大小周、隔周双休"
                    android:textColor="@color/sub"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_biweekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_holiday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_dialog_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="法定节假日放假"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_holiday_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="春节、国庆自动标成「休」"
                    android:textColor="@color/sub"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_holiday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_rotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_action_emphasis"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <!-- v1.11.5：这一行原来叫「改成几天一轮」，引导页同一件事叫「几天一轮的班」，
                 同一个入口两个名字。统一到引导页那个说法——「几天一轮的班」是人话，
                 「轮班」是术语，而且它是名词短语，跟上面两张开关卡的标题读起来是一类。
                 「改成」想交代的「这是一次修改」由下面的副标题接手。 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_rotation_entry_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="几天一轮的班"
                    android:textColor="@color/indigo"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- v1.11.5：补副标题。原来只有一行标题，比上面两张白卡矮一截，
                     而且没说「什么人来点它」。这句跟引导页逐字相同。 -->
                <TextView
                    android:id="@+id/tv_rotation_entry_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="四班三倒、上二休二"
                    android:textColor="@color/sub"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- v1.5.0：右侧从光秃秃的「›」改成「改 ›」，和上面那张旋转摘要卡
                 用同一套说法。
                 v1.11.5：v1.5.0 时这里写的是「括号里的两个例子也删了——上一张卡的
                 副标题刚说过『上四休二』」。这条理由其实站不住：上面那张摘要卡
                 （card_rotation）只在轮班态出现，而这张卡只在按周态出现，两者从不同屏。
                 现在例子加回来了，跟引导页逐字一致。 -->
            <TextView style="@style/SettingsChevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_back_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_action_emphasis"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="改成按周排"
                android:textColor="@color/indigo"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView style="@style/SettingsChevron" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:lineSpacingExtra="3dp"
            android:text="点日期即可修改，点「保存」后生效。"
            android:textColor="@color/sub"
            android:textSize="11.5sp" />
    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/bg_guide_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="保存"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
