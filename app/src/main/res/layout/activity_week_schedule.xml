<?xml version="1.0" encoding="utf-8"?>
<!-- 「我的班表」（v1.3.0 起，v1.18.0 重排）。

     历史：v1.3.0 把「周休制度」五选一弹窗换成了整页两周日历，「点格子就改」。
     到 v1.16.0 引导页改成五张制度卡之后，两处越走越远——同一个「换制度」，
     在引导页是最显眼的五张卡，在这里藏在最下面一行。

     用户 2026-11-05 18:47：「我的班表页要尽量和引导页一致，不要再用日期格子了」。
     现在这一页就是引导页第一屏 + 返回 + 保存：卡片来自 view_plan_cards.xml，
     两处同一份控件、同一套交互，不会再分叉。

     删掉的三样：
     1. 两周日期格子 —— 用户明确不要；改的粒度从「某一天」变成「整个制度」
     2. 「两周不一样」开关 —— 大小周卡已经表达同一件事
     3. 「法定节假日放假」开关 —— 挪去闹钟页的重复规则，那边才是「这条闹钟怎么响」

     点卡片只改草稿（v1.10.0 的规矩不变），底部「保存」才写盘并重排；
     有未保存的改动时返回会拦一下。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_time_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="‹ 返回"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="我的班表"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 和引导页第一屏同一份布局 -->
            <include
                android:id="@+id/week_page1"
                layout="@layout/view_plan_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

    <!-- 保存固定在底部，不随内容滚走（v1.10.0） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/bg_guide_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="保存"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
