<?xml version="1.0" encoding="utf-8"?>
<!-- 闹钟编辑对话框：名称 + 时间 + 重复规则 + 删除。
     v1.71.2：重复规则从系统单选圈改成卡片（DialogKit.optionView），
     与设置页、引导页同一套卡片语言；时间做成大字主信息；删除改淡红卡片。 -->
<!-- v1.27.1：外面套一层 ScrollView。加了第四个模式与「哪一天」行之后，
     内容在小屏上会超出对话框高度——而对话框本身不会滚，底部的「删除 / 取消 / 保存」
     会被顶出屏幕，等于没保存按钮。ScrollView 让内容自己滚，按钮始终在。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="名称" />

    <EditText
        android:id="@+id/et_alarm_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_time_outline"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="12"
        android:maxLines="1"
        android:padding="10dp"
        android:hint="可不填，默认叫「闹钟」"
        android:textColorHint="@color/sub"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="时间" />

    <!-- 时间是这张卡里最该被看见的东西：34sp、居中、字距略开。
         v1.71.3：去掉「点按修改时间」——控件本身的可点性一眼就能看出来，
         这行小字只是噪音。 -->
    <TextView
        android:id="@+id/tv_alarm_pick_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_time_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:letterSpacing="0.02"
        android:padding="14dp"
        android:text="07:30"
        android:textColor="@color/ink"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="重复规则" />

    <!-- v1.71.2：卡片在 AlarmEditor 里用 DialogKit.optionView 填，
         与设置页的单选弹窗同一套视觉（选中淡紫底 + 右侧勾） -->
    <LinearLayout
        android:id="@+id/ll_alarm_modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <!-- v1.27：只有选中「仅一次」才出现的那一天。默认隐藏，
         勾上即显示——免得每次编辑普通闹钟都让一个用不上的日期控件占位。 -->
    <LinearLayout
        android:id="@+id/row_once_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_time_outline"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="11dp"
        android:visibility="gone">

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="哪一天" />

        <TextView
            android:id="@+id/tv_once_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/indigo"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_alarm_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_danger_soft"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="12dp"
        android:text="删除这个闹钟"
        android:textColor="@color/danger"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>

</ScrollView>
