<?xml version="1.0" encoding="utf-8"?>
<!-- 闹钟编辑对话框：标题 + 名称 + 时间 + 重复规则 + 铃声。
     v0.77.0：重复规则从系统单选圈改成卡片（DialogKit.optionView），
     与设置页、引导页同一套卡片语言；时间做成大字主信息。 -->
<!-- v0.41.1：外面套一层 ScrollView。加了第四个模式与「哪一天」行之后，
     内容在小屏上会超出对话框高度——而对话框本身不会滚，底部的「取消 / 保存」
     会被顶出屏幕，等于没保存按钮。ScrollView 让内容自己滚，按钮始终在。 -->
<!-- v1.0.4：
     · 标题从 setTitle() 改成自绘。系统标题是 20sp 常规，而其它四个弹窗
       （铃声 / 睡前 / 周休 / 列表选择）都是 17sp 粗体——同一批弹窗两个规格，
       放一起一眼看出不是一套。
     · 「删除这个闹钟」从整宽淡红卡挪到按钮栏最左（neutral）。原来它紧贴在
       「保存」上方，手指从保存往上滑一点就落到删除上；现在中间隔着一个「取消」。
     · 四处字段格从 bg_time_outline（页面底色 / 灰格）换成 bg_field_outline
       （卡片底 + 细边）。原来同一列里灰格与白卡交替，像两种控件；
       现在与重复规则卡同底同描边，一个弹窗里只有一种「可点区块」。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="名称" />

    <EditText
        android:id="@+id/et_alarm_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_field_outline"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="12"
        android:maxLines="1"
        android:padding="10dp"
        android:hint="可不填，默认叫「闹钟」"
        android:textColorHint="@color/sub"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="时间" />

    <!-- 时间是这张卡里最该被看见的东西：34sp、居中、字距略开。
         v0.77.1：去掉「点按修改时间」——控件本身的可点性一眼就能看出来。
         v1.7.0：这一格既是输入也是结果。班表填过每天的时刻、且这条闹钟
         选「跟随我的班表」时，大字画的就是今天真正会响的时刻，下面补一行
         说明它从哪来。原来那个独立的「时间跟随班表」开关就删在这里。 -->
    <LinearLayout
        android:id="@+id/box_alarm_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_field_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="13dp"
        android:paddingBottom="11dp">

        <TextView
            android:id="@+id/tv_alarm_pick_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="07:30"
            android:textColor="@color/ink"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_alarm_time_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/sub"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="重复规则" />

    <!-- v0.77.0：卡片在 AlarmEditor 里用 DialogKit.optionView 填，
         与设置页的单选弹窗同一套视觉（选中淡紫底 + 右侧勾） -->
    <LinearLayout
        android:id="@+id/ll_alarm_modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <!-- v1.2.0：选中「轮班」「自定义」才出现的班表摘要。
         卡片本身只负责「选中」，真正的周期和逐日开关在这个入口后面——
         六张卡已经占掉大半屏，再往下摊一张 62 行的表就没法用了。 -->
    <LinearLayout
        android:id="@+id/row_own_rule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_own_rule"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4 天上 2 天"
            android:textColor="@color/indigo"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="改 ›"
            android:textColor="@color/sub"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- v1.27：只有选中「仅一次」才出现的那一天。默认隐藏，
         勾上即显示——免得每次编辑普通闹钟都让一个用不上的日期控件占位。 -->
    <LinearLayout
        android:id="@+id/row_once_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_field_outline"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="11dp"
        android:visibility="gone">

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="哪一天" />

        <TextView
            android:id="@+id/tv_once_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/indigo"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- v0.88.0：这条闹钟单独用的铃声。默认「跟随设置」，点开复用自绘铃声选择器。
         放在「哪一天」之后、删除之前：规则讲究了，才轮到声音。 -->
    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="铃声" />

    <TextView
        android:id="@+id/tv_alarm_ringtone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_field_outline"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:maxLines="2"
        android:padding="11dp"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>

</ScrollView>
