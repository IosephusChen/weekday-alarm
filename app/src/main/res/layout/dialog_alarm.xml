<?xml version="1.0" encoding="utf-8"?>
<!-- 闹钟编辑对话框：名称 + 时间 + 重复规则 + 删除。
     用自定义布局而非 setMessage + setSingleChoiceItems：后者在 MIUI 主题下
     单选列表不渲染（已实测复现），自绘 RadioGroup 三选项必然可见。 -->
<!-- v1.27.1：外面套一层 ScrollView。加了第四个模式与「哪一天」行之后，
     内容在小屏上会超出对话框高度——而对话框本身不会滚，底部的「删除 / 取消 / 保存」
     会被顶出屏幕，等于没保存按钮。ScrollView 让内容自己滚，按钮始终在。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="名称" />

    <EditText
        android:id="@+id/et_alarm_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_time_outline"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="12"
        android:maxLines="1"
        android:padding="10dp"
        android:text="起床"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="时间" />

    <TextView
        android:id="@+id/tv_alarm_pick_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_time_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="11dp"
        android:text="07:30"
        android:textColor="@color/ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="重复规则" />

    <RadioGroup
        android:id="@+id/rg_alarm_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_mode_workday"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="仅上班日（按周休制度，节假日不响）" />

        <RadioButton
            android:id="@+id/rb_mode_daily"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="每天" />

        <RadioButton
            android:id="@+id/rb_mode_weekend"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="仅休息日（双休=周末，单休=那一天）" />

        <RadioButton
            android:id="@+id/rb_mode_once"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="仅一次（临时闹钟，响完自动删）" />
    </RadioGroup>

    <!-- v1.27：只有选中「仅一次」才出现的那一天。默认隐藏，
         勾上即显示——免得每次编辑普通闹钟都让一个用不上的日期控件占位。 -->
    <LinearLayout
        android:id="@+id/row_once_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_time_outline"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="11dp"
        android:visibility="gone">

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="哪一天" />

        <TextView
            android:id="@+id/tv_once_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/indigo"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_alarm_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_time_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="11dp"
        android:text="删除这个闹钟"
        android:textColor="#DC2626"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>

</ScrollView>
