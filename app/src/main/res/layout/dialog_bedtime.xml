<?xml version="1.0" encoding="utf-8"?>
<!-- 睡前提醒时间选择（v1.20）。
     与其它设置一样用自绘 RadioGroup：MIUI / 澎湃 OS 上 setSingleChoiceItems
     经常只显示标题不显示选项（已实测），自绘布局最稳。
     选「其他时间」会接着弹出时/分滚轮。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_bedtime_title"
        android:textColor="@color/ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/dialog_bedtime_message"
        android:textColor="@color/sub"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/rg_bedtime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_bed_off"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/dialog_bedtime_off" />

        <RadioButton
            android:id="@+id/rb_bed_2130"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/dialog_bedtime_2130" />

        <RadioButton
            android:id="@+id/rb_bed_2200"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/dialog_bedtime_2200" />

        <RadioButton
            android:id="@+id/rb_bed_2230"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/dialog_bedtime_2230" />

        <RadioButton
            android:id="@+id/rb_bed_2300"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/dialog_bedtime_2300" />

        <RadioButton
            android:id="@+id/rb_bed_custom"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/dialog_bedtime_custom" />
    </RadioGroup>

    <!-- v1.60.0：「仅在明天上班时提醒」从更多设置里的独立开关行并入本对话框——
         它管的是睡前提醒发不发，和时刻是同一个决策的两半，分居两处要理解两遍。
         勾选即时生效；睡前提醒关着时压暗禁用（由代码控制）。 -->
    <CheckBox
        android:id="@+id/cb_bedtime_workday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="44dp"
        android:text="@string/dialog_bedtime_workday_only"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="2dp"
        android:text="@string/dialog_bedtime_workday_hint"
        android:textColor="@color/sub"
        android:textSize="12sp" />
</LinearLayout>
