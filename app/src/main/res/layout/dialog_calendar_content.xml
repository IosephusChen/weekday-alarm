<?xml version="1.0" encoding="utf-8"?>
<!--
  日历显示内容多选对话框（v1.60.0 自定义布局）。
  由「农历节日 / 二十四节气 / 基督教节日」三个设置开关合并而来——
  同一个决策拆三个开关，设置页平白多两行。Prefs 三个键不动，只换入口。

  同 dialog_horizon：不用 AlertDialog 的 setMultiChoiceItems——那个列表在 MIUI
  主题下同样有渲染问题（消息文字把列表挤出可见区域，单选列表已实测复现），
  自绘三行复选框必然可见。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_calendar_content_title"
        android:textColor="@color/ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/dialog_calendar_content_message"
        android:textColor="@color/sub"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.2" />

    <CheckBox
        android:id="@+id/cb_lunar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="44dp"
        android:text="@string/dialog_calendar_content_lunar"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/cb_solar_terms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:text="@string/dialog_calendar_content_solar"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/cb_christian"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:text="@string/dialog_calendar_content_christian"
        android:textColor="@color/ink"
        android:textSize="15sp" />
</LinearLayout>
