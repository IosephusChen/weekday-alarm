<?xml version="1.0" encoding="utf-8"?>
<!-- 自定义 / 轮班的编辑器（v1.1.0 新建，v1.1.1 重排）。

     两个入口共用这份布局，代码按 kind 决定藏哪几行：
     - 自定义（CYCLE_KIND_WEEK）：周期锁 7 天、起点锁本周一，所以「循环周期」「第 1 天是」
       两行都 GONE，列表标签是「周一…周日」；
     - 轮班（CYCLE_KIND_ROTATION）：两行都在，列表标签是「第 N 天 · 周X」。

     为什么是「N 行列表」而不是「一排格子」：澎湃的轮班制就是这个形状，
     用户从系统闹钟迁过来不用重新学；而且周期能到 62 天，格子铺 62 个既放不下也点不准。

     v1.1.1 的四处收整：
     ① 三张行卡从 bg_guide_option 换成 bg_dialog_row——前者是带 state_selected 的
        selector，这些行永远不会被选中，万一哪天被 setSelected 会莫名其妙变紫；
     ② 列表上方加一行统计（共 N 天 · 上班 x 天 · 休息 y 天），62 天的表不用自己数；
     ③ ScrollView 关掉滚动条——它贴着卡片右缘划出一道灰线，比内容还显眼；
        高度由代码按内容算（不足 7 行不留空白，超过则滚动）；
     ④ 底部提示改成随 kind 变的两句话。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.35"
        android:text="第 1 天定下来，往后按 N 天一轮排。"
        android:textColor="@color/sub"
        android:textSize="12sp" />

    <!-- 循环周期（仅轮班） -->
    <LinearLayout
        android:id="@+id/row_len"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_dialog_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="16dp"
        android:paddingBottom="13dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="循环周期"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_len"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7 天"
            android:textColor="@color/indigo"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="›"
            android:textColor="@color/sub"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 第 1 天是哪天（仅轮班） -->
    <LinearLayout
        android:id="@+id/row_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="16dp"
        android:paddingBottom="13dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="第 1 天是"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今天"
            android:textColor="@color/indigo"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="›"
            android:textColor="@color/sub"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 节假日开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="11dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="法定节假日放假"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_holiday_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="轮班一般春节也上班，默认不勾"
                android:textColor="@color/sub"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- SwitchCompat 而不是 <Switch>：只有它吃得到 SwitchKit 的 tint，
             ROM 自带的「关 = 黑拇指」才不会把这一行画成整张卡里最重的元素。 -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_holiday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 统计：62 天的表不靠用户自己数 -->
    <TextView
        android:id="@+id/tv_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.02"
        android:text="共 7 天 · 上班 5 天 · 休息 2 天"
        android:textColor="@color/sub"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 逐天列表：最多 62 行，必须能滚。
         高度由 CycleEditor 按实际内容夹到 [0, 300dp]，7 天时不留空档。 -->
    <ScrollView
        android:id="@+id/scroll_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/list_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="点某一天可以设具体时间，或者标成休息。"
        android:textColor="@color/sub"
        android:textSize="11sp" />
</LinearLayout>
