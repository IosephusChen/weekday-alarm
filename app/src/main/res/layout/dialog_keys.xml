<?xml version="1.0" encoding="utf-8"?>
<!-- 按键设置对话框（v1.16）：响铃时音量键 / 电源键的作用。
     自绘 RadioGroup 而非 setSingleChoiceItems：后者在 MIUI 主题下单选列表
     可能不渲染（已实测复现），自绘必然可见。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="音量键（响铃时按）" />

    <RadioGroup
        android:id="@+id/rg_volkey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_volkey_none"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="无（按系统默认调音量）" />

        <RadioButton
            android:id="@+id/rb_volkey_snooze"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="稍后提醒" />

        <RadioButton
            android:id="@+id/rb_volkey_stop"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="关闭闹钟" />
    </RadioGroup>

    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="电源键（响铃时按）" />

    <RadioGroup
        android:id="@+id/rg_powerkey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_powerkey_none"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="无（按系统默认息屏）" />

        <RadioButton
            android:id="@+id/rb_powerkey_snooze"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="稍后提醒" />

        <RadioButton
            android:id="@+id/rb_powerkey_stop"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="关闭闹钟" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="提示：电源键在多数机型由系统接管（直接息屏、不传给应用），设置为「稍后提醒 / 关闭」可能不生效；息屏后闹钟界面仍会在点亮屏幕时显示。"
        android:textColor="@color/sub"
        android:textSize="12sp" />
</LinearLayout>
