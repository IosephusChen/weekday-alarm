<?xml version="1.0" encoding="utf-8"?>
<!-- 提前提醒设置对话框（v1.17）：响铃前多久在通知栏预告（可提前关掉该次响铃）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="提前多久提醒" />

    <RadioGroup
        android:id="@+id/rg_pre_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_pre_off"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="关闭" />

        <RadioButton
            android:id="@+id/rb_pre_5"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="提前 5 分钟" />

        <RadioButton
            android:id="@+id/rb_pre_10"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="提前 10 分钟" />

        <RadioButton
            android:id="@+id/rb_pre_15"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="提前 15 分钟" />

        <RadioButton
            android:id="@+id/rb_pre_30"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="提前 30 分钟" />

        <RadioButton
            android:id="@+id/rb_pre_60"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="提前 1 小时" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="提示：到点前会主动弹窗（锁屏也能看到），可以顺手关掉这一次；弹窗本身不响铃、不震动，声音留给真正的闹钟。开启后每个响铃实例会多占一个系统闹钟名额，App 会自动把主闹钟排程上限减半（200），保证不超过 ROM 的 500 硬限。"
        android:textColor="@color/sub"
        android:textSize="12sp" />
</LinearLayout>
