<?xml version="1.0" encoding="utf-8"?>
<!-- 响铃时长设置对话框（v1.18）：响多久后自动停止。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="响铃多久后自动停止" />

    <RadioGroup
        android:id="@+id/rg_ring_minutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_ring_off"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="不限（一直响到手动停止）" />

        <RadioButton
            android:id="@+id/rb_ring_1"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="1 分钟" />

        <RadioButton
            android:id="@+id/rb_ring_3"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="3 分钟" />

        <RadioButton
            android:id="@+id/rb_ring_5"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="5 分钟" />

        <RadioButton
            android:id="@+id/rb_ring_10"
            style="@style/WeekRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="10 分钟" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="提示：到点自动停止响铃与震动，并撤下通知。设为「不限」则一直响到手动停止/小睡。"
        android:textColor="@color/sub"
        android:textSize="12sp" />
</LinearLayout>
