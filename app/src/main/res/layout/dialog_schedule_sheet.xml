<?xml version="1.0" encoding="utf-8"?>
<!-- 「N 天一轮」的编辑表（v1.4.0）。

     这张布局取代了 dialog_cycle.xml 与 dialog_alarm_cycle.xml 两份近重复文件：
     全局「我的班表 → 按 N 天一轮」和一条闹钟的「自己排一周 / 轮班」本来是同一件事，
     只是前者每天多一个时刻。版式、ID、构建逻辑现在只有一份，代码按 Role 决定藏哪几块。

     与上一版的差别（对着真机截图改的）：
     ① 周期 / 起点两行原来是两张独立白卡，各 56dp、中间还隔着 10dp；合成一张两行的卡，
        省下 20dp——7 天的表在弹窗里本来要滚才能看到周日，就是被这些空隙挤掉的；
     ② 统计从一行灰字（和副标题同级，看着像说明）改成一条浅底结论条，一眼能落住；
     ③ 列表行的左侧圆点删掉：它跟右边的开关表达同一件事，且「灰点」读起来像不可点；
     ④ 状态改用「班 / 休」小胶囊，与引导页、我的班表的格子同一套颜色，不再用 Switch——
        一条 N 天的表本质是排班，不是一组开关。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.35"
        android:text="首日班次确定后，按此顺序循环。"
        android:textColor="@color/sub"
        android:textSize="12sp" />

    <!-- 周期 + 起点：一张卡两行。只有「轮班」露出这两行，
         「自定义」两者都锁死（7 天、本周一），露出来反而让人以为能改。 -->
    <LinearLayout
        android:id="@+id/box_params"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dialog_row"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/row_len"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="46dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="11dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="循环周期"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_len"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 天"
                android:textColor="@color/indigo"
                android:textSize="14sp" />

            <TextView style="@style/SettingsChevron" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="14dp"
            android:background="@color/line" />

        <LinearLayout
            android:id="@+id/row_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="46dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="11dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="第 1 天是"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今天"
                android:textColor="@color/indigo"
                android:textSize="14sp" />

            <TextView style="@style/SettingsChevron" />
        </LinearLayout>
    </LinearLayout>

    <!-- v1.19.0：节假日开关这一整块删掉。它搬到「编辑闹钟」弹窗（dialog_alarm.xml）
         的一级行，和「铃声」平级——原来藏在「自己排一周 → 自定义弹窗」里三层深。
         读写的值仍是单条闹钟的 Alarm.cycleHoliday，Seed.holiday 照旧透传
         （全局 CycleEditor 靠它写 Prefs），只是这张弹窗里不再摆第二个开关。 -->

    <!-- 结论条：一行字说清这张表上几天休几天。62 天的表不靠用户自己数。
         用 section_bg 而不是白卡——弹窗本身就是白的，白压白等于没有这一条。 -->
    <TextView
        android:id="@+id/tv_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sheet_summary"
        android:letterSpacing="0.02"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp"
        android:text="共 7 天 · 上班 5 天 · 休息 2 天"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- v1.19.0 ⑥：只有「闹钟·按周」这一种 Role 用横排七格（一二三四五六日），
         和引导页第一页「自定义」卡那七格同一套 bg_plan_day / plan_pick_text。
         格子由 ScheduleSheet.buildWeekCells() 动态建，这里只留容器、默认 GONE：
         轮班（最多 62 天）、全局周、ShiftCycleSheet 都还走下面的逐日列表。 -->
    <LinearLayout
        android:id="@+id/box_week_cells"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_10"
        android:orientation="horizontal"
        android:visibility="gone" />

    <!-- 逐天列表：最多 62 行，必须能滚。
         高度由 ScheduleSheet 按实际内容夹到 [1 行, 6 行]，7 天时不留空档。 -->
    <ScrollView
        android:id="@+id/scroll_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fadingEdgeLength="28dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/list_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="点哪天，改那天几点上班；不上班就标休息。"
        android:textColor="@color/sub"
        android:textSize="11sp" />
</LinearLayout>
