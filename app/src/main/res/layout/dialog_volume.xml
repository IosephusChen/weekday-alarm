<?xml version="1.0" encoding="utf-8"?>
<!-- 闹钟音量对话框（v1.16）：SeekBar 0-100，0 = 静音仅震动。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_volume_title"
        android:textColor="@color/ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/dialog_volume_message"
        android:textColor="@color/sub"
        android:textSize="12sp" />



    <!-- 与设置主页那条同一套轨道与滑块（v0.61.4）；padding 留出滑块半径，否则贴到 0 就被裁 -->
    <SeekBar
        android:id="@+id/seek_volume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:max="100"
        android:minHeight="36dp"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:progressDrawable="@drawable/seek_track"
        android:splitTrack="false"
        android:thumb="@drawable/seek_thumb" />

    <TextView
        android:id="@+id/tv_volume_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="80%"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="拖到 0 = 静音，响铃时不发声（震不震看「响铃时震动」）"
        android:textColor="@color/sub"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="测试响铃会用当前音量，可即时验证效果"
        android:textColor="@color/sub"
        android:textSize="12sp" />
</LinearLayout>
