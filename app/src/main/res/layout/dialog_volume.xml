<?xml version="1.0" encoding="utf-8"?>
<!-- 闹钟音量对话框（v1.16）；v0.90.1 重排：值移到标题行右侧，滑块下加两端刻度。

     为什么要动（用户拿澎湃的闹钟设置页做对比）：那边一条粗胶囊轨道 + 一块实心
     填充 + 右上角的当前值，一眼能读出"这是一个有下限的量"。我们原来是一条 4dp
     细线、一个空心环、下面一个居中的大数字——线太轻，读起来像分隔线；数字离
     轨道远，拖的时候眼睛要在两处来回跑。

     更要紧的是"拉不到最小"这件事：音量下限改成 10% 之后，滑块停在最左边时
     轨道左侧没有任何填充，看起来像"还没开始调"。现在标题行右边永远显示真实
     数值（拖到最左是 10%），滑块下方两端再标出 10% / 100%，下限就不再需要猜。

     v0.91.0：刻度不再写死。音量条直接读写系统 STREAM_ALARM，量程是机型的
     实际档位数（7 档、15 档都有），最低那一档换算是 10% 还是 14% 由系统决定，
     文字由调用方按 AlarmVolume.minPercent() 填。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dialog_volume_title"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_volume_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/indigo"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/dialog_volume_message"
        android:textColor="@color/sub"
        android:textSize="12sp" />

    <!-- 与设置主页那条同一套轨道与滑块（v0.61.4）；padding 留出滑块半径（14dp），
         否则拖到最左时左半会被自己的边界裁掉 -->
    <SeekBar
        android:id="@+id/seek_volume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="36dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:progressDrawable="@drawable/seek_track"
        android:splitTrack="false"
        android:thumb="@drawable/seek_thumb" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/tv_volume_floor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/sub"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="@color/sub"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
