<?xml version="1.0" encoding="utf-8"?>
<!-- 周休制度（v1.49.2 分层，v1.49.5 换成和引导页同一套卡片）。

     v1.49.0 之前是 4 个平铺选项（大小周 / 双休 / 单休·周日 / 单休·周六），
     v1.49.2 拆成「先选大类，下面按选中的大类展开细节」。

     v1.49.5 只改呈现：大类从单选行换成三张卡（标题 + 副标题），
     条件项从竖排单选换成「标签在左、胶囊在右」，与新手引导第 1 页同一套。
     用户在引导里选过一次，回来改时应该认出这是同一个东西。

     卡片沿用 bg_guide_option：未选中是 card 底 + 1dp 细边（在白对话框上表现为描边卡），
     选中是淡紫底 + 主色描边，靠 setSelected 切换。
     id 一个都没改——测试与调用方按 id 找控件，换类型不影响查找。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="周休制度"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.2"
            android:text="决定哪天要上班、哪天休息，日历和闹钟都按它推算。改错会整天算错班。"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <!-- 大类：三张卡，与引导页第 1 页同款 -->
        <LinearLayout
            android:id="@+id/rg_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rb_big_small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_guide_option"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="13dp"
                android:paddingEnd="16dp"
                android:paddingBottom="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="大小周"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="一周双休、一周单休，两周循环"
                    android:textColor="@color/sub"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rb_double"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_guide_option"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="13dp"
                android:paddingEnd="16dp"
                android:paddingBottom="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="双休"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="每周六、周日都休"
                    android:textColor="@color/sub"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rb_single"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_guide_option"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="13dp"
                android:paddingEnd="16dp"
                android:paddingBottom="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="单休"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="每周固定休一天"
                    android:textColor="@color/sub"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 仅大小周：本周是大周还是小周 + 小周休哪天 -->
        <LinearLayout
            android:id="@+id/box_big_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="本周是"
                    android:textColor="@color/sub"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/rg_week_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rb_big"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_guide_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="34dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="大周"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/rb_small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_guide_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="34dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="小周"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="小周休哪天"
                    android:textColor="@color/sub"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/rg_small_rest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rb_rest_sun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_guide_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="34dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="周日休"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/rb_rest_sat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_guide_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="34dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="周六休"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 仅单休：休哪天 -->
        <LinearLayout
            android:id="@+id/box_single"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="休哪天"
                android:textColor="@color/sub"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/rg_single_rest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rb_single_sun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_guide_option"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="34dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="周日休"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/rb_single_sat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_guide_option"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="34dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="周六休"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
