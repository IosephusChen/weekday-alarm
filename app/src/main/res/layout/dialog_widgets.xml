<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小部件说明（v0.91.7）。

  原来这里是 DialogKit.showMessage 的一段纯文字（pin_guide_message）：三步路径 +
  三行尺寸说明。问题有两个——

  1. 路径写漏了一层。真实的澎湃是「长按桌面空白处 → 小部件 → 全部应用 →
     最底下『安卓小部件』→ 打工人闹钟」，而「安卓小部件」这一组是第三方 App 的
     唯一入口，多数人翻不到「全部应用」就放弃了。写错路径比不写更让人挫败。
  2. 三个组件只有一句话描述，用户得先加一个才知道长什么样。三张预览图
     （xxhdpi，本来就是配给 launcher 的）一直躺在包里没派上用场。

  现在改成图 + 名字 + 用途，路径单独放最底下说清楚。

  标题不放进 ScrollView：内容不到一屏，但字体放大时仍要能滚，标题钉住更稳。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="桌面小部件"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.2"
            android:text="不用点开 App，桌面直接看下次响铃和这周班表"
            android:textColor="@color/sub"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/dlg_widget_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <!-- 三项：图 + 名字 + 用途。三张图宽高比不同（1.52 / 1.25 / 1.0），
                 统一塞进 144×96dp 的框里 fitCenter，左边缘与文字起点因此对齐；
                 v0.91.8 起框本身画了底板（bg_widget_preview），右边缘看着也不齐的问题
                 就变成了「图在框里居中」，而不是「三张图大小不一」。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="144dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_widget_preview"
                    android:contentDescription="下次响铃预览"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_next_alarm_preview" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4×2 下次响铃"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:text="今天上不上班、下次几点响、这周哪天上班"
                        android:textColor="@color/sub"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="144dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_widget_preview"
                    android:contentDescription="整月班表预览"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_week_schedule_month_preview" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4×4 整月班表"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:text="整月哪天上班、哪天休息，顶部带下一个闹钟"
                        android:textColor="@color/sub"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="144dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_widget_preview"
                    android:contentDescription="紧凑月历预览"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_month_minimal_preview" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4×3 紧凑月历"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:text="同一个月班表，去掉底部统计行，更省桌面高度"
                        android:textColor="@color/sub"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 路径单独说，并且要写全。上一版漏掉「全部应用 → 安卓小部件」两层，
                 而第三方 App 的组件恰恰只在那最后一组里。 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="怎么加到桌面"
                android:textColor="@color/sub"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="3dp"
                android:text="长按桌面空白处 →「小部件」→「全部应用」→ 最底下「安卓小部件」→ 打工人闹钟"
                android:textColor="@color/indigo"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="有的桌面把「小部件」叫「添加工具」；找不到「全部应用」时，直接翻到列表最底下那一组。"
                android:textColor="@color/sub"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
