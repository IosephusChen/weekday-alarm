<?xml version="1.0" encoding="utf-8"?>
<!--
  响铃时的横幅（v1.41.0，原来是 300dp 的小卡片浮在屏幕中间）。

  用户原话：「这悬浮窗出现在屏幕中间也太突兀了，要参考系统闹钟来做」。系统闹钟在解锁使用中
  弹的是**贴顶的通栏横幅**：左侧图标、中间标题，右侧两个圆形按钮（稍后提醒 / 停止），
  从状态栏下面滑下来，不挡屏幕中间的内容。

  这个窗口由 WindowManager 以 TYPE_APPLICATION_OVERLAY 挂上去，需要「显示悬浮窗」权限；
  没权限时 AlarmService 会退回整屏。锁屏 / 息屏仍然走整屏（那时候横幅没人看得见）。

  宽度不在这里写死：FloatingAlarm 按屏幕宽度减去左右各 8dp 算好后塞进 LayoutParams。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_float_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_notif_icon"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/ic_notification" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fa_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fa_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/sub"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 稍后提醒：空心圆 + 时钟图标。文案在代码里塞进 contentDescription（无障碍要读得出）。 -->
    <ImageButton
        android:id="@+id/fa_snooze"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_float_btn_outline"
        android:contentDescription="稍后再响"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notif_snooze"
        android:tint="@color/indigo"
        android:visibility="gone" />

    <!-- 停止：实色紫圆 + 方块图标，位置最右、最显眼，和系统闹钟一致 -->
    <ImageButton
        android:id="@+id/fa_stop"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_float_btn_solid"
        android:contentDescription="停止"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_float_stop"
        android:tint="@color/white" />
</LinearLayout>
