<?xml version="1.0" encoding="utf-8"?>
<!-- 「N 天一轮」编辑表里的一行（v1.4.0）。

     从左到右：标题（含「今天」小标签）→ 时刻（仅全局那张有）→ 状态胶囊。
     上一版这里是「圆点 + 标题 + 值 + ›」：圆点和值说的是同一件事，而灰圆点读起来
     像「不可点」，可那行恰恰是唯一能点的地方。现在状态做成胶囊，颜色与引导页、
     我的班表的格子同一套色系（上 = 浅靛底 + 靛字，休 = 淡灰底 + 细边），
     点整行切换或开单日弹层。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/row_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="50dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/tv_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="周一"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_tag_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_tag_today"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="今天"
            android:textColor="@color/day_today_text"
            android:textSize="11sp"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 只有全局那张表有：这一天几点响。空的时刻不占位，胶囊仍然贴右边。 -->
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="07:30"
            android:textColor="@color/sub"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_state_work"
            android:gravity="center"
            android:minWidth="40dp"
            android:minHeight="28dp"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:text="班"
            android:textColor="@color/indigo"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="14dp"
        android:background="@color/line" />
</LinearLayout>
