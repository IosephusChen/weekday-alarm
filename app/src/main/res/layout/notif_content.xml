<?xml version="1.0" encoding="utf-8"?>
<!--
  通知卡片的折叠态自绘布局（v0.33.0 引入；v0.54.0 回到单行，见下）。

  为什么必须自绘：锁屏卡片和「下拉但没展开」渲染的都是折叠态，系统模板里只有
  小图标 + 标题 + 一行正文，**不渲染 addAction 的按钮**。所以「关闭闹钟」「明天请假」
  这些操作如果只靠 addAction，锁屏上永远看不到。设了 customContentView，折叠态才由我们说了算。

  为什么又回到单行（v0.54.0）：v0.53.1 为了塞下倒计时，把卡片改成「图标 + 三行文字」
  再加一行按钮，用户直接说「不如之前紧凑」。而且折叠态有高度上限，内容超了系统不是
  整体缩小，而是**把最后一行压扁**——按钮那行首当其冲，字被切成两半（v0.53.1 的 bug）。
  现在回到 v0.53.0 的结构：图标在左、标题与正文在中间、药丸在右，一行说完。
  倒计时没有单独占一行，而是挤在正文右边（正文让出位置），高度不变。

  四个使用方共用这一个布局，靠 setViewVisibility 决定显示几个按钮：
  提前提醒（关闭闹钟）、响铃（停止 / N 分钟后再响）、睡前提醒（明天请假）、
  稍后再响（取消）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/nc_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="6dp"
        android:src="@drawable/ic_notification"
        android:background="@drawable/bg_notif_icon"
        android:contentDescription="@null" />

    <!-- 文字不画任何底（v0.89.9）。颜色的唯一来源是 @color/ink / @color/indigo —
         它们有 values-night 版本，而这份布局是 SystemUI 在**它自己的进程、它自己的
         配置**下 inflate 的，切深浅色时系统重建通知视图，颜色随之重解析。
         代码里一行 setTextColor 都不写：那才是把颜色焊死在创建时刻的原因。
         正文不加第二个灰度 token，用 ink + 78% 透明度做层次——一个色两端都对。 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nc_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 正文与倒计时同一行：卡片只有一行，倒计时挤在右边 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nc_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:alpha="0.78"
                android:includeFontPadding="false"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <Chronometer
                android:id="@+id/nc_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:includeFontPadding="false"
                android:textColor="@color/indigo"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 药丸在右侧，和 v0.53.0 一致：一次只露出一个主操作时最紧凑。
         高度写死 30dp + 文字居中：wrap_content 一旦被折叠态上限压扁，
         字就会从上下两头被切掉（v0.53.1 的 bug）。

         次操作（v0.89.9）：不画底，只留字。它是「次要操作」，本来就不该有实体感；
         而任何自绘的底都要在「浅卡 / 深卡」之间二选一，选哪个都在另一边上突兀。
         纯文字 + @color/indigo（有夜里更亮的一版）就没有这个两难。 -->
    <TextView
        android:id="@+id/nc_action2"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:minWidth="44dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/indigo"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/nc_action"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_notif_action"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:minWidth="44dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
