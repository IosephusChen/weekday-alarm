<?xml version="1.0" encoding="utf-8"?>
<!--
  提前提醒的横幅（heads-up）自绘布局（v0.32.0）。

  为什么不用 addAction：Android 原生 SystemUI 的 heads-up 视图只渲染大图标、
  标题和一行正文，不渲染 action 按钮——所以通知栏里能看到「关闭闹钟」，
  横幅上却什么都没有。澎湃系统自带的闹钟之所以能在横幅上带按钮，
  是因为它用 setCustomHeadsUpContentView 把按钮画进了布局里，我们照做。

  RemoteViews 支持的控件有限，这里只用 LinearLayout / ImageView / TextView。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/hu_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_notification"
        android:background="@drawable/bg_notif_icon"
        android:contentDescription="@null" />

    <!-- 文字自带品牌紫底，理由同 notif_content.xml：文字色在构建时写死，
         卡片底色由 SystemUI 实时画，两者会脱钩（v0.89.8）。 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_notif_text"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hu_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hu_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hu_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_notif_action"
        android:includeFontPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="这次不响"
        android:textSize="13sp" />
</LinearLayout>
