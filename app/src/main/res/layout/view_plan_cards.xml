<?xml version="1.0" encoding="utf-8"?>
<!--
    五张周休制度卡（v1.18.0）。引导页第 1 屏和「我的班表」共用这一份。

    抽出来的原因：v1.16.0 引导页改成卡片后，「我的班表」还停在两周日历上，两处越走越远。
    用户 2026-11-05 18:47：「我的班表页要尽量和引导页一致」。做两份长得像的迟早分叉，
    所以做一份，两处 <include>。以后改卡片只改这里。

    差异只有顶栏和底部按钮，由宿主页面自己给，不在这个文件里。

    交互语法（和睡前提醒弹窗一致）：紫边 + 淡紫底 = 选中，没有单选圆。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/card_plan_double"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_guide_option"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_8">

        <TextView
            android:id="@+id/tv_plan_double"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="双休"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="每周六、周日都休"
            android:textColor="@color/sub"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_plan_single"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:background="@drawable/bg_guide_option"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_8">

        <TextView
            android:id="@+id/tv_plan_single"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="单休"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="每周固定休一天"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <!-- 单休具体休哪天（v1.17.0）：原来这里选中就固定写成「周日休」，
             想休周六的人得进「我的班表」再改一次。数据里本来就有
             SINGLE_REST_SAT，缺的只是入口。和大小周那两行同一套 chip。 -->
        <LinearLayout
            android:id="@+id/box_plan_single"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="休哪天"
                android:textColor="@color/sub"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_single_sun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plan_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="76dp"
                android:minHeight="32dp"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:text="周日休"
                android:textColor="@color/plan_pick_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_single_sat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_plan_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="76dp"
                android:minHeight="32dp"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:text="周六休"
                android:textColor="@color/plan_pick_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 大小周：选中后原地长出两行胶囊。数据上它不是新类型，就是一个 14 天周期，
         和「我的班表」里那张 14 天表存的是同一个东西（cycle_len / cycle_mask /
         anchor / small_rest_sat 一个字段都不新增）。 -->
    <LinearLayout
        android:id="@+id/card_plan_bigsmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:background="@drawable/bg_guide_option"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_8">

        <TextView
            android:id="@+id/tv_plan_bigsmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="大小周"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="一周双休、一周单休，两周循环"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/box_plan_bigsmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="本周是"
                    android:textColor="@color/sub"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chip_big_week"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_plan_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="76dp"
                    android:minHeight="32dp"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="大周"
                    android:textColor="@color/plan_pick_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chip_small_week"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_plan_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="76dp"
                    android:minHeight="32dp"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="小周"
                    android:textColor="@color/plan_pick_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="小周休哪天"
                    android:textColor="@color/sub"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chip_rest_sun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_plan_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="76dp"
                    android:minHeight="32dp"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="周日休"
                    android:textColor="@color/plan_pick_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chip_rest_sat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_plan_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="76dp"
                    android:minHeight="32dp"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="周六休"
                    android:textColor="@color/plan_pick_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 轮班制：选中后三行就地展开，不再弹窗（用户 16:40 提的）。

         v1.17.0 用四个 −/+ 按钮调周期和起始日。用户 18:47：「几天一轮不要用 +- 按钮，
         这天数多了得按累死」——62 天要按 61 次。v1.18.0 改成点数字，弹滚轮，1–62 一把滑到底。

         格子按周期长度铺满：7 天一行，8–14 两行，15–62 全部铺开（最多 9 行）。
         早期做过「两行视口 + 区内滚」，用户 18:38 否掉：「展开得太少了，不方便编辑」。 -->
    <LinearLayout
        android:id="@+id/card_plan_rotation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:background="@drawable/bg_guide_option"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_8">

        <TextView
            android:id="@+id/tv_plan_rotation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="轮班制"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="几天一轮，自己标哪天上班"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/box_plan_rotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="几天一轮"
                    android:textColor="@color/sub"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_plan_cycle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_plan_chip"
                    android:clickable="true"
                    android:contentDescription="改周期长度"
                    android:drawablePadding="@dimen/space_6"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="32dp"
                    android:minWidth="86dp"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="4 天"
                    android:textColor="@color/plan_pick_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="今天第几天"
                    android:textColor="@color/sub"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_plan_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_plan_chip"
                    android:clickable="true"
                    android:contentDescription="改今天是第几天"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="32dp"
                    android:minWidth="86dp"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="第 1 天"
                    android:textColor="@color/plan_pick_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 这排格子没有标题：「几天一轮，自己标哪天上班」已经写在
                 卡片副标题里，再挂一行「每天上什么班」等于同一句话说两遍。 -->

            <!-- 格子由 renderCycleDays() 按周期长度建，这里只留容器 -->
            <LinearLayout
                android:id="@+id/box_plan_cycle_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:orientation="vertical" />

            <!-- v1.20.0 丙：撤掉「编辑这一轮的班次与时刻 ›」（ShiftCycleSheet 弹层入口）。
                 逐日排班本来就在这排就地格子里，两套 UI 做同一件事，用户分不清该在哪儿改。
                 弹层的长处（一次选到位、看周几 / 今天）已补回格子：点格子弹
                 「休息 + 各班次 + 管理班次」列表。ShiftCycleSheet 类保留（fit / summaryOf
                 仍有调用方），只是不再从这里进。

                 v1.20.0 ③：这一行是「班次定义」的唯一管理入口，引导页 / 班表页共用布局、
                 两页常驻。0 个班次时写「还没有班次，去建一个 ›」，≥1 个时写
                 「管理班次 · N 个 ›」，文案由 PlanCardsView.renderRotation() 按状态切。
                 以前只在空态出现、建完就藏，用户第一次建完班次后再也找不到新建 / 编辑入口。 -->
            <TextView
                android:id="@+id/tv_plan_shift_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="@dimen/space_6"
                android:paddingBottom="@dimen/space_6"
                android:text="还没有班次，去建一个 ›"
                android:textColor="@color/indigo"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 自定义：选中后原地展开七格。只有这一项需要格子——能用一句话描述清楚的
         四种班，点卡就够了。 -->
    <LinearLayout
        android:id="@+id/card_plan_custom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:background="@drawable/bg_guide_option"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_8">

        <TextView
            android:id="@+id/tv_plan_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自定义"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="勾周一到周日，每周固定"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/box_plan_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:orientation="horizontal"
            android:visibility="gone">
            <!-- 七格由 addDayBoxes() 按 DAY_NAMES 填，这里只留容器：
                 七个控件连同间距一起手写，改一个字宽就要改七处。 -->
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
