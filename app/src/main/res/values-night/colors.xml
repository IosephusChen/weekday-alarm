<?xml version="1.0" encoding="utf-8"?>
<!--
  夜间配色（跟随系统暗色模式自动生效）。
  设计原则：语义色保持「同色相、低明度」——格子的类型辨识度不变（靛蓝/灰/黄/红/靛蓝描边），
  只是整体压暗以适应深色底；文字色统一提亮到 300 阶，保证深底上的对比度（>=4.5:1）。
-->
<resources>
    <!-- 主题基色 -->
    <color name="indigo">#818CF8</color>       <!-- indigo-400，暗底上更鲜明 -->
    <color name="indigo_dark">#4F46E5</color>
    <color name="violet">#A78BFA</color>
    <color name="ink">#F1F3FE</color>          <!-- 主文字：近白 -->
    <color name="sub">#9AA0BE</color>          <!-- 次要文字：中灰，对比度 4.6:1+ -->
    <color name="body">#A9B0CC</color>         <!-- 正文：对 card 7.5:1，比 sub 亮一档 -->
    <color name="card">#1C1F35</color>         <!-- 卡片：深靛蓝灰 -->
    <color name="bg">#0F1120</color>           <!-- 页面底：深靛黑 -->
    <color name="line">#2A2E47</color>         <!-- 描边/分隔线 -->
    <!-- 设置页分组标题条的底（v0.54.1）。
         日间是 #F7F8FD（比卡片略浅），夜间原来没有覆盖，于是深色页面上出现一条近白横条，
         而条里的字是 @color/sub（中灰）——用户截图里「排程与节假日」「提醒」两段就是一片发白。
         这里取比 card(#1C1F35) 略亮一档的靛蓝灰，和 sub 的对比度约 5.7:1。 -->
    <color name="section_bg">#242840</color>

    <!-- 响铃横幅（v0.55.0）：卡片本身就是深色，夜间版只是「再沉一点」，
         免得半夜一块偏亮的板子糊在锁屏上。文字与按钮两套完全一致。 -->
    <color name="float_card_bg">#E6121420</color>
    <color name="float_card_line">#33FFFFFF</color>
    <color name="float_card_time">#FFFFFF</color>
    <color name="float_card_sub">#CCFFFFFF</color>
    <color name="float_card_icon">#FFFFFF</color>
    <color name="float_btn_outline_bg">#1FFFFFFF</color>
    <color name="float_btn_outline_line">#59FFFFFF</color>
    <!-- 引导页 / 班表卡选中项：比 card(#1C1F35) 亮一档的靛蓝灰，配 ink（近白）对比约 9:1。
         v1.20.3：原来取 #2A2350，比轮班格底(#1C1F35) 和格子描边(#2A2E47) 都亮——
         真机（1000110845）逐像素采样坐实：选中轮班卡时四格塌成暗洞、1dp 描边整条被吃掉、
         格内班次块(#2A2350) 与卡片同色连成一片。压到 #232038 后卡片与格底同档，
         格子重新靠描边浮起来；选中感交给 1.5dp indigo 描边，不再靠"整卡发紫"。 -->
    <color name="guide_option_selected">#232038</color>
    <!-- 「改排班模式」入口（v1.11.4）：与 guide_option_selected 同一档，
         配 @color/indigo(#818CF8) 的字与箭头，对比约 4.7:1。
         v1.20.3 不跟 guide_option_selected 一起压暗：它是一块"可点的入口条"，
         压在 card 上要比四周亮一点才像个按钮，同屏出现时也不会被误读成选中卡片。 -->
    <color name="action_bg">#2A2350</color>
    <color name="action_line">#4A4380</color>
    <color name="white">#FFFFFFFF</color>
    <!-- 语义色（夜间）：与 day_makeup_text / day_overtime_text 同一档亮度 -->
    <!-- 闹钟配色（夜间）：与 day_*_text 同一档亮度，深底上才看得清 -->

    <color name="danger">#F87171</color>   <!-- red-400 -->
    <color name="success">#4ADE80</color>  <!-- green-400 -->
    <color name="success_text">#4ADE80</color>  <!-- 夜间深底上 6.3:1，和 success 同值即可 -->
    <!-- 危险操作的淡底（夜间）：比卡片底略偏红，红字压上去才立得住 -->
    <color name="danger_soft">#3A1D22</color>

    <!-- ===== 开关配色（夜间）=====
         轨道和拇指分别压在 card(#1C1F35) / line(#2A2E47) 上，所以要跟着变；
         关状态的拇指取 #6B7194：比轨道亮、比文字暗，是「灰调」而不是「黑洞」。 -->
    <color name="switch_track_on">#66818CF8</color>   <!-- indigo-400 40% -->
    <color name="switch_track_off">#2A2E47</color>
    <color name="switch_thumb_on">#818CF8</color>     <!-- indigo-400 -->
    <color name="switch_thumb_off">#6B7194</color>

    <!-- ===== 日历格子与图例语义色（夜间）===== -->
    <color name="day_work_bg">#232847</color>
    <color name="day_work_stroke">#3D4470</color>
    <color name="day_work_text">#A5B4FC</color>   <!-- indigo-300 -->
    <color name="day_work_label">#93A0C4</color>  <!-- 「班」字：比 indigo-300 灰一档，5.5:1 -->

    <color name="day_rest_bg">#23263C</color>
    <color name="day_rest_stroke">#3A3F58</color>
    <color name="day_rest_text">#CBD5E1</color>   <!-- slate-300 -->

    <color name="day_holiday_bg">#3A2F16</color>
    <color name="day_holiday_stroke">#5C4A24</color>
    <color name="day_holiday_text">#FCD34D</color> <!-- amber-300 -->

    <color name="day_makeup_bg">#3D2226</color>
    <color name="day_makeup_stroke">#5F343B</color>
    <color name="day_makeup_text">#FCA5A5</color>  <!-- red-300 -->

    <color name="day_vacation_bg">#2E2A4A</color>
    <color name="day_vacation_stroke">#4C4468</color>
    <color name="day_vacation_text">#C4B5FD</color>  <!-- violet-300 -->

    <color name="day_overtime_bg">#3B2A17</color>
    <color name="day_overtime_stroke">#6B4A24</color>
    <color name="day_overtime_text">#FDBA74</color>  <!-- orange-300 -->

    <color name="day_today_bg">#2A2F5C</color>
    <color name="day_today_stroke">#818CF8</color>
    <color name="day_today_text">#C7D2FE</color>   <!-- indigo-200 -->

    <!-- 非当月格子数字：压暗但可辨 -->
    <color name="day_dim_text">#454B70</color>

    <!-- 「班」格底色（v1.13.0）。日间是 indigo-600，夜间不用 indigo-400：
         那个紫在白字下只有 2.96:1。这里换成更沉的一档，5.5:1。
         见 values/colors.xml 同一组注释。 -->
    <color name="work_cell_bg">#5A52EA</color>

    <!-- 班表「休」格与结论条（v1.5.0）。见 values/colors.xml 同一组注释。
         休格要比 card(#1C1F35) 亮一档、又别亮过 line(#2A2E47) 太多——
         它是一块「关着的格子」，不是又一根分隔线。 -->
    <color name="rest_cell_bg">#343956</color>
    <!-- 轮班格子统一底（v1.20.2）：夜间对齐丙效果图的近黑 #1D1F33，取 card 同值。
         真机 v1.20.1 的今天格是 card(#1C1F35 黑)、其他格是 rest_cell_bg(#343956 灰)，
         用户指出「今天格背景是黑的，其他格子是灰的」——这里让四格都回到近黑。 -->
    <color name="cycle_cell_bg">#1C1F35</color>
    <!-- 轮班格子的细边（v1.20.3）：夜里格子靠它显形，不能借 pill_rest_stroke(#2A2E47)。
         那个值只比格底亮 5 级、又比卡片暗——压在选中卡片上直接消失（真机采样坐实）。
         取 #353A59：比格底亮约 26 级，在 card 与 #232038 上都勾得出来，
         又比 line(#2A2E47) 克制，不至于让四格看着像四根分隔线。 -->
    <color name="cycle_cell_stroke">#353A59</color>
    <color name="verdict_bg">#2A2350</color>

    <!-- 「班」胶囊的底：与结论条同值，夜间 #818CF8 压上去 4.9:1 -->
    <color name="pill_work_bg">#2A2350</color>

    <!-- 「休」胶囊细边：比 #343956 深一档，与日间同一个方向 -->
    <color name="pill_rest_stroke">#2A2E47</color>
</resources>
