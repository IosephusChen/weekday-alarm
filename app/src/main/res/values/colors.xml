<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="indigo">#4F46E5</color>
    <color name="indigo_dark">#4338CA</color>
    <!-- 通知文字的自带底色已在 v0.89.9 删除。通知里不再有任何自绘色块：
         文字色直接用 ink / sub（下面那对语义色，有 values-night 版本），
         布局由 SystemUI 按它自己的明暗配置 inflate，颜色随之重解析。 -->
    <!-- 桌面图标底色 v1.0.5 起不再是颜色：改成了 @drawable/ic_launcher_bg
         的纵向渐变（v0.76.1 那条「图标底色必须日夜一个色」的教训搬进了
         那个文件，改动前先读它）。 -->
    <color name="violet">#7C3AED</color>
    <color name="ink">#1E2235</color>
    <color name="sub">#6B7189</color>
    <!-- 正文第三档（v1.1.0）：介于 ink 与 sub 之间，给「要读一段」的弹窗正文用。
         sub 在白底上是 4.8:1，配 12sp 只是勉强过线（中文小字实际读感更差）；
         ink 是 15:1，整段读下来像一屏标题。这个色 6.6:1，是中段最舒服的位置。 -->
    <color name="body">#565C72</color>
    <color name="card">#FFFFFF</color>
    <color name="bg">#F4F5FB</color>
    <color name="line">#E7E9F3</color>
    <!-- 引导页「已选中」选项卡的底（v0.53.2）。
         以前写死在 bg_guide_option.xml 里是 #EEF0FE（近白），
         而卡片文字用的是 @color/ink —— 深色模式下 ink 变近白，
         白字压白底，选中那一项等于消失了。 -->
    <color name="guide_option_selected">#EEF0FE</color>
    <color name="section_bg">#F7F8FD</color>
    <!-- 「改排班模式」入口（v1.11.4）。

         班表页的「改成几天一轮 / 改成按周排」和引导页的「几天一轮的班」，原来和
         普通白卡一模一样，用户看不出它是这一页的关键动作（截图反馈「不显眼」）。
         换成淡靛蓝底 + 同色描边，字与箭头用 @color/indigo——比加图标轻，
         又足够从一列白卡里跳出来。

         底取 guide_option_selected 同一档：那个色已经被「选中的选项卡」用过，
         在这两个页面上不会同时出现，撞不到。夜间那对在 values-night 里。 -->
    <color name="action_bg">#EEF0FE</color>
    <color name="action_line">#C3C7F2</color>
    <!-- 响铃横幅（v0.55.0）：深色半透明卡，白天夜里都用这一张。

         v0.54.2 是暖桃色，用户看过后要的是「透明感，和其他通知栏一样」。
         真模糊拿不到（第三方悬浮窗基本吃不到系统跨窗口模糊，见 FloatingAlarm 注释），
         所以用「深色 + 88% 不透明」近似通知栏那种浮在内容之上的观感：
         底下透出一点点壁纸，但字仍然压得住。

         注意这里全是带 alpha 的颜色，算对比度要先合成到某个底色上，
         不能直接丢给 ColorUtils.calculateContrast（它要求两边都不透明）。 -->
    <color name="float_card_bg">#E61B1D2B</color>
    <color name="float_card_line">#33FFFFFF</color>   <!-- 白 20% 描边 -->
    <color name="float_card_time">#FFFFFF</color>
    <color name="float_card_sub">#CCFFFFFF</color>    <!-- 白 80% -->
    <color name="float_card_icon">#FFFFFF</color>
    <color name="float_btn_outline_bg">#1FFFFFFF</color>     <!-- 白 12%（v0.92.0 从 8% 提亮，配渐变停止钮） -->
    <color name="float_btn_outline_line">#59FFFFFF</color>   <!-- 白 35%（v0.92.0 从 70% 压柔，别抢停止钮） -->
    <!-- v0.92.0 悬浮窗 B：卡片底改成「压暗的品牌紫」渐变，和首页 hero 卡同一族色。
         这两组是固定 token，不跟夜间模式——横幅只在响铃那一刻出现，那一刻要的是
         「被叫醒」，不是「融入主题」，深色底上白字才有对比。 -->
    <color name="float_card_bg_start">#F02A2158</color>     <!-- 顶：偏亮的深紫 -->
    <color name="float_card_bg_end">#F0161230</color>       <!-- 底：更深的紫黑 -->
    <color name="float_stop_start">#A78BFA</color>          <!-- 停止钮渐变：亮紫 -->
    <color name="float_stop_end">#6D28D9</color>            <!-- 停止钮渐变：深紫 -->
    <color name="white">#FFFFFFFF</color>
    <!-- 语义色（v0.43.0）：删除 / 危险操作与「已开启」状态。
         以前这两处分别写死在 dialog_alarm.xml 和 GuideActivity 里，
         深色模式下 #DC2626 / #16A34A 压在 #1C1F35 卡片上对比度只有 3:1 左右。 -->
    <color name="danger">#DC2626</color>
    <color name="success">#16A34A</color>
    <!-- 小字用的深一档绿（v1.1.0）：「已登记」这类 11sp 徽章。
         success(#16A34A) 压在白底上只有 3.3:1，做徽章（淡绿底 + 同色字）更低到 2.9:1，
         而 11sp 不算大字号，要求 4.5:1。这个色对同款 18% 底是 5.8:1。
         正文里的大字仍然用 success——那里够。 -->
    <color name="success_text">#166534</color>
    <!-- 危险操作的淡底（v0.77.0）：删除按钮用它托底，不再是白底红字 -->
    <color name="danger_soft">#FDF1F1</color>

    <!-- ===== 开关配色（v1.1.0）=====
         AlarmRowRenderer 和设置页那几个 SwitchCompat，从创建到销毁没设过任何 tint，
         于是长什么样完全由 ROM 决定：MIUI 上「关」是黑拇指 + 深灰轨道、「开」是紫拇指。
         结果是整张闹钟卡里最黑的元素是个「已关闭」的开关，扫一眼先看到午休，
         而不是还在生效的起床。

         配色规则：开 = 紫调（淡紫轨 + 紫拇指），关 = 灰调（浅灰轨 + 中灰拇指）。
         用「色相」而不是「明度」区分开关，关掉的那条就不会因为拇指太黑反而更重。

         四个色都有夜间版：轨道和拇指分别压在 card / line 上，那两个色会随明暗变。 -->
    <color name="switch_track_on">#5C4F46E5</color>   <!-- indigo 36%，浅到白拇指压得住 -->
    <color name="switch_track_off">#E1E4F0</color>
    <color name="switch_thumb_on">#4F46E5</color>
    <color name="switch_thumb_off">#B9BFD4</color>

    <!-- ===== 日历格子与图例语义色（日间）=====
         底色与 bg_day_*.xml 的 solid 一致；描边为同色系淡边（今天为 indigo 主色）。
         MainActivity.setupLegend / renderCalendar 通过资源引用读取，保证图例与格子永远同源。 -->
    <color name="day_work_bg">#EEF2FF</color>
    <color name="day_work_stroke">#C7D2FE</color>
    <color name="day_work_text">#4338CA</color>
    <!-- 「班」字专用（v1.1.0）：日期数字继续用 day_work_text，标签单独降一档。
         同色时一个工作日格子里有两个一样重的元素，19 个格子并排就是 19 对
         分不出「几号」和「上不上班」。这个字不能删——只靠底色表达班休，
         蓝灰色弱的用户读不出来（WCAG 1.4.1），所以只能降重不能去掉。
         #5B6480 对 #EEF2FF 是 5.2:1，退后但仍在大字号门槛之上。 -->
    <color name="day_work_label">#5B6480</color>

    <color name="day_rest_bg">#F1F5F9</color>
    <color name="day_rest_stroke">#CBD5E1</color>
    <color name="day_rest_text">#64748B</color>

    <!-- v1.23.27：bg/stroke 暂时没有消费者了（法定假不再占底色），
         但配置备份和老版本回滚还要能对上这个名字，先留着。
         text 现在就是格子右上角那个三角的颜色：一小片面积，要压得住灰底又不脏，
         所以从 amber-800 提到 amber-700。 -->
    <color name="day_holiday_bg">#FEF3C7</color>
    <color name="day_holiday_stroke">#FDE68A</color>
    <color name="day_holiday_text">#B45309</color>

    <color name="day_makeup_bg">#FEE2E2</color>
    <color name="day_makeup_stroke">#FECACA</color>
    <color name="day_makeup_text">#B91C1C</color>

    <!-- 个人请假：淡紫，与法定节假日（黄）明确区分 -->
    <color name="day_vacation_bg">#F3E8FF</color>
    <color name="day_vacation_stroke">#DDD6FE</color>
    <color name="day_vacation_text">#7C3AED</color>

    <!-- 个人加班（v0.13.0）：橙色，与调休补班（红）明确区分 -->
    <color name="day_overtime_bg">#FFEDD5</color>
    <color name="day_overtime_stroke">#FDBA74</color>
    <color name="day_overtime_text">#C2410C</color>

    <color name="day_today_bg">#E0E7FF</color>
    <color name="day_today_stroke">#4F46E5</color>
    <color name="day_today_text">#312E81</color>

    <!-- 非当月格子数字 -->
    <color name="day_dim_text">#C9CEED</color>

    <!-- 「班」格自己的底色（v1.13.0）。

         在这之前它直接引 @color/indigo，可 indigo 在 values-night 里被提亮成
         #818CF8——白字压上去只有 2.96:1，14sp bold 也不够。同一个 indigo 在别处
         扮演的是「字色 / 描边」（压在浅底上），只有这七格拿它当满色底。
         一个色承担两种角色，夜间就必然有一头不对。

         拆出独立 key 后日间仍是 #4F46E5（白字 6.4:1、对 bg #F4F5FB 是 4.7:1，
         格子边界清楚）；夜间换成 #5A52EA 而不是继续提亮——深色模式要的是
         「这块是满的」，白字 5.5:1、对 bg 3.4:1，仍然是一块，不发光。
         别把这里改回 @color/indigo，理由和 hero_start 那组一样。 -->
    <color name="work_cell_bg">#4F46E5</color>

    <!-- ===== 班表格子与结论条（v1.5.0）=====

         「休」格原来是白底 + 发丝边（bg_day_cell_rest 走 card + line），压在同样是
         浅色的页面底（bg #F4F5FB）上——白比底还亮，边界只剩一根 1dp 线。于是一行
         六个实心紫块配一个「白洞」，读起来像那一格没填。

         改成实心填充，与「班」的实心紫同一套语法：一个满色、一个淡色，都是一块，
         不是「一块 + 一个框」。N 天一轮表里的休胶囊（bg_state_rest）共用这个色——
         它俩说的是同一件事，之前一个用 line、一个用 card + 描边，两处不一样。

         #E2E6F2 上压 @color/body（#565C72）是 5.4:1；夜间 #343956 上压 #A9B0CC
         是 5.0:1，两档都在小字门槛之上（「休」是 14sp bold，不是大字号）。 -->
    <color name="rest_cell_bg">#E2E6F2</color>

    <!-- 轮班格子统一底（v1.20.2）：四格同色，今天只靠描边 + 骑沿角标区分，
         不再像 bg_plan_day 那样 selected 换底色（浅色白底 / 深色近黑，两套差太远）。

         v1.20.4：日间从 rest_cell_bg 的同值 #E2E6F2 改成纯白。用户装了 v1.20.3 发来
         浅色真机图（1000110850）说「格子底色灰灰的不好看」——采样坐实是两层问题：
         格子 #E2E6F2 是块低饱和的灰蓝，而卡片选中底是淡紫 #EEF0FE，灰蓝压淡紫，
         交界处直接发脏；同时「班」块 #E7EAFE、「休」块 #E2E6F2 都跟格底几乎同亮度，
         四格糊成一片灰。格底回到白以后，淡紫的「班」和淡灰的「休」各自浮得起来，
         和班表页（白卡）里的班/休胶囊是同一套观感，不用再造新色。
         夜间仍取 card 同值 #1C1F35，见 values-night/colors.xml。 -->
    <color name="cycle_cell_bg">#FFFFFF</color>

    <!-- 轮班格子的细边（v1.20.3）：日间原来是 pill_rest_stroke 的同值 #D3D9E8，
         v1.20.4 跟着白格底提到 #E4E7F5——偏靛的淡灰线，在白卡上勾得出轮廓，
         又不像 #D3D9E8 那样发灰。夜间那根必须比 pill_rest_stroke 亮得多才显形，
         两边各走各的，所以单独起名。 -->
    <color name="cycle_cell_stroke">#E4E7F5</color>

    <!-- 普通格「周X」胶囊的底与边（v1.22.0）。2026-11-06 17:43 用户要求
         「每一个格子都带周 x 胶囊，只有今天有紫色外框线」——胶囊从「今天专属」
         变成每格一枚，于是需要一种比今天那枚实心 indigo 轻、又能从格底浮起来的样子。
         底取 guide_option_selected 同值 #EEF0FE（浅靛），边比它深一档；
         字压 @color/indigo：#4F46E5 对 #EEF0FE 是 5.9:1，9sp bold 够读。
         今天那枚继续走 bg_cycle_today（实心 indigo + 反白字）——两者不能同色，
         同色就等于今天淹没在表里，而它现在只剩紫框这一条线索了。 -->
    <color name="cycle_badge_bg">#EEF0FE</color>
    <color name="cycle_badge_line">#DDE1FB</color>

    <!-- 「班」胶囊的底（v1.5.0 二次调）。与 verdict_bg 同值不同名：一个说的是
         「这张表排成什么样」，一个说的是「这一天上班」，将来动其中一个不该连累另一个。
         字压 @color/indigo：#4F46E5 对 #E7EAFE 是 5.6:1，12sp bold 够。 -->
    <color name="pill_work_bg">#E7EAFE</color>

    <!-- 「休」胶囊的细边：比 rest_cell_bg 深一档，两样都变浅后靠它把少数派拎出来。
         不能用 @color/line——#E7E9F3 比 #E2E6F2 还浅，等于画在空气里。 -->
    <color name="pill_rest_stroke">#D3D9E8</color>

    <!-- 结论条（v1.5.0）：浅靛底 + 靛字，从「第五张白卡」里分出来。
         班表页从上到下五张卡原来全是 bg_dialog_row，于是最该被一眼看到的那句
         「你现在按哪张表排」和「要不要跟节假日」长得一模一样，得逐行读才知道
         哪句是结论。底色一旦不同，它就从「一个设置项」变回「一句结论」。

         文字用 @color/indigo：日间 #4F46E5 对 #E7EAFE 是 5.6:1，夜间 #818CF8
         对 #2A2350 是 4.9:1。 -->
    <color name="verdict_bg">#E7EAFE</color>

    <!-- ===== 紫色卡片渐变（v0.73.1）=====
         小部件根背景、首页「今日状态」卡、响铃页整屏共用同一套紫。
         v0.73.1 之前它们直接引用 @color/indigo / @color/violet，而这两个色在
         values-night 里被提亮成 indigo-400 / violet-400——于是深色模式下
         三张卡一起变成淡粉紫，压在深色壁纸上发灰，用户截图反馈「不好看」，
         要求「和浅色一样就行」。

         渐变是这套 UI 的识别色，不是主题色：它不承担「适配深浅模式」的职责，
         深浅模式下都该是同一个紫。所以这三个色故意不进 values-night，
         并在 ColorTokenTest.NIGHTLESS 里登记。

         注意别把这些值又「顺手」改成引用 indigo / violet——那等于改回 v0.73.x。 -->
    <color name="hero_start">#4F46E5</color>   <!-- indigo-600，渐变起点 -->
    <color name="hero_end">#7C3AED</color>     <!-- violet-600，渐变终点 -->
    <!-- 压在实白底上的紫字（小组件「今天已请假 / 明天已请假」）。
         原来是 @color/indigo_dark，而它在夜间被换成 #4F46E5——比日间亮一档，
         白底上对比度从 7:1 掉到 5.6:1。小部件不随明暗变，这里也跟着固定。 -->
    <color name="hero_text">#4338CA</color>

    <!-- ===== 本周班表小组件（v0.24.0）=====
         组件底色是紫色渐变（bg_hero），因此标签取同色系浅色：
         上班用纯白最醒目，休息降到淡紫灰，节假日/补班/请假/加班各自沿用日历语义色系的亮版。 -->
    <!-- 注意：这一组「故意」没有 values-night 版本。
         小组件的底是固定紫色渐变（hero_start → hero_end，见上），
         深浅模式下都一样，标签色压在那块紫上，跟着明暗变反而会失真。
         v0.73.1 之前这条注释说「底是固定的」其实不成立——bg_hero 引用的
         indigo / violet 有夜间版，只是当时没人在小部件上看出来。
         如果哪天小组件改成跟随主题的底，记得回来把这六个色补进夜间配色，
         并把 ColorTokenTest.NIGHTLESS 里对应的名字删掉。 -->
    <color name="widget_dim">#C7CBF0</color>
    <color name="widget_rest">#C7D2FE</color>
    <color name="widget_holiday">#FDE68A</color>
    <color name="widget_makeup">#FCA5A5</color>
    <color name="widget_vacation">#DDD6FE</color>
    <color name="widget_overtime">#FDBA74</color>
</resources>
