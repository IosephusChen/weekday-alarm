<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="indigo">#4F46E5</color>
    <color name="indigo_dark">#4338CA</color>
    <color name="violet">#7C3AED</color>
    <color name="ink">#1E2235</color>
    <color name="sub">#6B7189</color>
    <color name="card">#FFFFFF</color>
    <color name="bg">#F4F5FB</color>
    <color name="line">#E7E9F3</color>
    <!-- 引导页「已选中」选项卡的底（v1.39.0）。
         以前写死在 bg_guide_option.xml 里是 #EEF0FE（近白），
         而卡片文字用的是 @color/ink —— 深色模式下 ink 变近白，
         白字压白底，选中那一项等于消失了。 -->
    <color name="guide_option_selected">#EEF0FE</color>
    <color name="section_bg">#F7F8FD</color>
    <!-- 响铃横幅（v1.42.0）：暖桃色，参照系统闹钟的 heads-up。
         底色写死一个暖色而不是跟主题走，是因为这张卡只在「正在响铃」时出现，
         那一刻需要的是「被叫醒」而不是「融入界面」；深色模式另有压暗版本。 -->
    <color name="float_card_bg">#FFF6EC</color>
    <color name="float_card_line">#F0DFC8</color>
    <color name="float_card_title">#2A2018</color>
    <color name="float_card_sub">#8A6A4E</color>   <!-- 桃底上 4.6:1 -->
    <color name="white">#FFFFFFFF</color>
    <!-- 语义色（v1.28）：删除 / 危险操作与「已开启」状态。
         以前这两处分别写死在 dialog_alarm.xml 和 GuideActivity 里，
         深色模式下 #DC2626 / #16A34A 压在 #1C1F35 卡片上对比度只有 3:1 左右。 -->
    <!-- 闹钟配色（v1.30）：列表里给时间大字染色，多条闹钟一眼分清「哪条是起床」。
         0 是默认（不染色，用主文字色），其余三个是可选色。 -->
    <color name="alarm_color_0">#1E2235</color>   <!-- 默认：与 ink 同色 -->
    <color name="alarm_color_1">#C2410C</color>   <!-- 橙 -->
    <color name="alarm_color_2">#15803D</color>   <!-- 绿 -->
    <color name="alarm_color_3">#6D28D9</color>   <!-- 紫 -->

    <color name="danger">#DC2626</color>
    <color name="success">#16A34A</color>

    <!-- ===== 日历格子与图例语义色（日间）=====
         底色与 bg_day_*.xml 的 solid 一致；描边为同色系淡边（今天为 indigo 主色）。
         MainActivity.setupLegend / renderCalendar 通过资源引用读取，保证图例与格子永远同源。 -->
    <color name="day_work_bg">#EEF2FF</color>
    <color name="day_work_stroke">#C7D2FE</color>
    <color name="day_work_text">#4338CA</color>

    <color name="day_rest_bg">#F1F5F9</color>
    <color name="day_rest_stroke">#CBD5E1</color>
    <color name="day_rest_text">#64748B</color>

    <color name="day_holiday_bg">#FEF3C7</color>
    <color name="day_holiday_stroke">#FDE68A</color>
    <color name="day_holiday_text">#92400E</color>

    <color name="day_makeup_bg">#FEE2E2</color>
    <color name="day_makeup_stroke">#FECACA</color>
    <color name="day_makeup_text">#B91C1C</color>

    <!-- 个人请假：淡紫，与法定节假日（黄）明确区分 -->
    <color name="day_vacation_bg">#F3E8FF</color>
    <color name="day_vacation_stroke">#DDD6FE</color>
    <color name="day_vacation_text">#7C3AED</color>

    <!-- 个人加班（v1.15）：橙色，与调休补班（红）明确区分 -->
    <color name="day_overtime_bg">#FFEDD5</color>
    <color name="day_overtime_stroke">#FDBA74</color>
    <color name="day_overtime_text">#C2410C</color>

    <color name="day_today_bg">#E0E7FF</color>
    <color name="day_today_stroke">#4F46E5</color>
    <color name="day_today_text">#312E81</color>

    <!-- 非当月格子数字 -->
    <color name="day_dim_text">#C9CEED</color>

    <!-- ===== 本周班表小组件（v1.20）=====
         组件底色是紫色渐变（bg_hero），因此标签取同色系浅色：
         上班用纯白最醒目，休息降到淡紫灰，节假日/补班/请假/加班各自沿用日历语义色系的亮版。 -->
    <color name="widget_dim">#C7CBF0</color>
    <color name="widget_rest">#C7D2FE</color>
    <color name="widget_holiday">#FDE68A</color>
    <color name="widget_makeup">#FCA5A5</color>
    <color name="widget_vacation">#DDD6FE</color>
    <color name="widget_overtime">#FDBA74</color>
</resources>
