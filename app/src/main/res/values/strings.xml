    <string name="dialog_horizon_title">提醒范围</string>
    <string name="dialog_horizon_message">节假日安排目前内置到 2026 年底。选择更长范围时，超出部分按当前周休制度推算（法定放假与调休补班不会自动覆盖），2027 年安排公布后 App 更新数据即可自动生效，无需改设置。</string>
    <string name="dialog_horizon_90">90 天（默认）</string>
    <string name="dialog_horizon_180">180 天</string>
    <string name="dialog_horizon_365">365 天（一整年）</string>
    <string name="dialog_calendar_content_title">日历显示内容</string>
    <string name="dialog_calendar_content_message">日历格子里除了「班 / 休」，还可以显示这些名字。挑想看的，不影响闹钟排班。</string>
