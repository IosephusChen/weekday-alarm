<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.WeekdayAlarm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/indigo</item>
        <item name="colorPrimaryVariant">@color/indigo_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- v0.40.4：响铃页专用主题（AlarmActivity 单独挂上）。

         为什么不用主主题：主主题 statusBarColor 是浅色 @color/bg、windowBackground
         是 Material3 的白，而背景只画在内容区的 LinearLayout 上——于是状态栏和导航条
         那两条落在白底上，锁屏时就是两块白边夹着紫屏。

         这里的做法是让内容画到系统栏底下（windowBackground 直接给渐变，
         系统栏区域取不到内容视图，就透出窗口背景），而不是去给系统栏「填色」：
         填色只能让那两条变成纯色，渐变在顶/底会断成两截；铺窗口背景整屏只有一份，
         没有任何接缝。

         windowLightStatusBar 关掉：紫底上必须用浅色图标，继承主主题的 true 会是黑字。 -->
    <style name="Theme.WeekdayAlarm.Ringing" parent="Theme.WeekdayAlarm">
        <item name="android:windowBackground">@drawable/bg_hero_full</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- API 27 起支持；老系统忽略该属性，不会崩 -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- 锁屏显示自测页（v0.55.3）：固定深底，不跟随日夜。
         它要盖在任何壁纸、任何锁屏上，跟着日间主题变成浅底就看不见了。
         windowShowWhenLocked / turnScreenOn 在代码里设，这里只管底色和去标题。 -->
    <style name="Theme.WeekdayAlarm.LockProbe" parent="Theme.WeekdayAlarm">
        <item name="android:windowBackground">#1B1D2B</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 「时 / 分」滚轮选择器的文字样式：居中大字，选中值加粗主色 -->
    <style name="WheelPickerText">
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/sub</item>
        <item name="android:textSize">22sp</item>
        <item name="colorControlActivated">@color/indigo</item>
        <!-- v0.77.1：分隔线原来是深靛蓝（跟随 colorControlNormal），
             两列各画一条、在弹窗上横贯成两条长线；改成发丝线色后只剩「选中行」的暗示。 -->
        <item name="android:colorControlNormal">@color/line</item>
    </style>

    <style name="WeekChip">
        <item name="android:background">@drawable/bg_chip_white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <!-- 分区标题（「闹钟 / 排班与节假日 / 提醒 / 其他」）。
         v0.73.3 之前与行标题（SettingsTitle）同为 15sp 粗体 ink 色——分组头混在行里
         认不出，设置页像一张没有结构的平铺列表。现在学 iOS 设置页的做法：
         分区头降到 13sp + 次级灰，行标题保持 15sp 深色，层级一眼可辨。 -->
    <style name="SectionTitle">
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FieldLabel">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FieldHint">
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ===== 使用说明页（v0.50.0）=====
         原来这 9 条是一整块 12sp 的灰字，读起来像免责声明。改成「小节标题 + 条目」：
         标题 15sp 加粗、条目 14sp 正文色，找「组件怎么加」能直接扫到那一节。

         v0.76.5 两处排版收紧：
         ① 条目改「圆点列 + 正文列」两列（HelpItemRow + HelpDot）——以前「· 正文」
            是一个 TextView，换行后第二行顶到最左边和圆点齐平，一段话里出现两条
            左边界，扫读时眼睛来回找；现在圆点占位列、正文自动换行只对齐正文。
         ② 小节标题前加 circled number（HelpSectionRow）——五节并列时序号比
            光秃秃的标题更能说清「这是第几类、一共几类」。 -->
    <style name="HelpSection">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 小节标题行：序号 + 标题横排 -->
    <style name="HelpSectionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- 条目行：圆点列 + 正文列（悬挂缩进） -->
    <style name="HelpItemRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">top</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <!-- 圆点列：固定宽占位，主色加粗，和正文基线对齐由 gravity=top 保证 -->
    <style name="HelpDot">
        <item name="android:layout_width">12dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">·</item>
        <item name="android:textColor">@color/indigo</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HelpItem">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <!-- ===== 设置列表（v0.22.1）=====
         所有行统一「左标题 + 右值/开关」，行高与左右内边距一致，
         避免旧版「有的居中、有的左对齐」造成的视觉错位。 -->
    <style name="SettingsTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingsValue">
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="SettingsSummary">
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <!-- 行末箭头：与右值同色，统一 16sp，保证每行右侧基线一致 -->
    <style name="SettingsChevron">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/space_6</item>
        <item name="android:text">›</item>
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">17sp</item>
    </style>


    <!-- ===== 使用说明页（v0.83.0）=====
         只做版式，文案全在 strings.xml。改一句话不该再动布局。 -->
    <style name="HelpToc">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">@dimen/space_6</item>
        <item name="android:background">@drawable/bg_guide_option</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">@dimen/space_12</item>
        <item name="android:paddingTop">@dimen/space_6</item>
        <item name="android:paddingEnd">@dimen/space_12</item>
        <item name="android:paddingBottom">@dimen/space_6</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <style name="HelpCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/space_8</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingTop">@dimen/space_12</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:paddingBottom">@dimen/space_12</item>
    </style>





    <style name="HelpJump">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_guide_perm</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/space_12</item>
        <item name="android:paddingEnd">@dimen/space_12</item>
    </style>

    <style name="HelpJumpText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <style name="HelpJumpAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/indigo</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 响铃横幅的出入场动画（v0.54.1）：贴顶滑入 / 滑出。
         挂在 WindowManager.LayoutParams.windowAnimations 上，见 FloatingAlarm。 -->
    <style name="FloatWindowAnim">
        <item name="android:windowEnterAnimation">@anim/float_in</item>
        <item name="android:windowExitAnimation">@anim/float_out</item>
    </style>

    <!-- 稍后提醒的短提示（v0.55.2）：淡入淡出，不滑动 -->
    <style name="FloatToastAnim">
        <item name="android:windowEnterAnimation">@anim/float_toast_in</item>
        <item name="android:windowExitAnimation">@anim/float_toast_out</item>
    </style>







    <!-- 行内分隔线：左右各留 16dp，与标题左边缘对齐 -->
    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">@dimen/space_16</item>
        <item name="android:layout_marginEnd">@dimen/space_16</item>
        <item name="android:background">@color/line</item>
    </style>

</resources>
