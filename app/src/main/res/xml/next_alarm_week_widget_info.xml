<?xml version="1.0" encoding="utf-8"?>
<!-- 「下一个闹钟和本周」4×4（v1.50.0）。

     原来这是「下一个闹钟」拉到 4×4 时才出现的布局（v1.49.12 的按高度分档）。
     尺寸锁定之后不需要再猜高度，直接做成独立组件：要闹钟 + 本周就选这个，
     只要闹钟就选 4×2 那个。

     250dp 是 4×4 的常见高度；内容 = 闹钟两行 + 七格 + 底部两个按钮。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="1800000"
    android:previewImage="@drawable/widget_next_alarm_week_preview"
    android:previewLayout="@layout/widget_next_alarm_tall"
    android:initialLayout="@layout/widget_next_alarm_tall"
    android:description="@string/widget_next_alarm_week_desc"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
